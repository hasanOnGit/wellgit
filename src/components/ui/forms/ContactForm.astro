---
const formStrings = {
  name: 'Your Name',
  email: 'Email Address',
  message: 'How can our engineering team help you?',
  submit: 'Send Message',
};
---

<form id="contact-form" class="p-4" aria-labelledby="form-title" method="POST" action="/api/contact">
  {/* Fieldset and legend for grouping form elements */}
  <fieldset class="space-y-4">
    <legend id="form-title" class="sr-only">{formStrings.submit}</legend>

    {/* Name input field */}
    <div class="relative">
      <input
        type="text"
        name="name"
        id="input-name"
        class="peer block w-full rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-800 not-placeholder-shown:pt-6 not-placeholder-shown:pb-2 placeholder:text-transparent autofill:pt-6 autofill:pb-2 focus:border-teal-600 focus:bg-white focus:pt-6 focus:pb-2 focus:ring-2 focus:ring-teal-600/20 focus:outline-hidden transition-all duration-200"
        placeholder={formStrings.name}
        required
        aria-required="true"
        aria-labelledby="input-name-label"
      />
      <label
        id="input-name-label"
        for="input-name"
        class="pointer-events-none absolute start-0 top-0 h-full truncate border border-transparent p-4 text-slate-500 transition duration-100 ease-in-out peer-not-placeholder-shown:-translate-y-1.5 peer-not-placeholder-shown:text-xs peer-not-placeholder-shown:text-slate-600 peer-focus:-translate-y-1.5 peer-focus:text-xs peer-focus:text-teal-600"
      >
        {formStrings.name}
      </label>
    </div>

    {/* Email input field */}
    <div class="relative">
      <input
        type="email"
        name="email"
        id="input-email"
        class="peer block w-full rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-800 not-placeholder-shown:pt-6 not-placeholder-shown:pb-2 placeholder:text-transparent autofill:pt-6 autofill:pb-2 focus:border-teal-600 focus:bg-white focus:pt-6 focus:pb-2 focus:ring-2 focus:ring-teal-600/20 focus:outline-hidden transition-all duration-200"
        placeholder={formStrings.email}
        required
        aria-required="true"
        aria-labelledby="input-email-label"
        aria-invalid="false"
      />
      <label
        id="input-email-label"
        for="input-email"
        class="pointer-events-none absolute start-0 top-0 h-full w-full truncate border border-transparent p-4 text-slate-500 transition duration-100 ease-in-out peer-not-placeholder-shown:-translate-y-1.5 peer-not-placeholder-shown:text-xs peer-not-placeholder-shown:text-slate-600 peer-focus:-translate-y-1.5 peer-focus:text-xs peer-focus:text-teal-600"
      >
        {formStrings.email}
      </label>
    </div>

    {/* Message textarea field */}
    <div class="relative">
      <textarea
        name="message"
        id="input-message"
        rows="4"
        class="peer block w-full rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-800 not-placeholder-shown:pt-6 not-placeholder-shown:pb-2 placeholder:text-transparent autofill:pt-6 autofill:pb-2 focus:border-teal-600 focus:bg-white focus:pt-6 focus:pb-2 focus:ring-2 focus:ring-teal-600/20 focus:outline-hidden transition-all duration-200"
        placeholder={formStrings.message}
        required
        aria-required="true"
        aria-labelledby="input-message-label"></textarea>
      <label
        id="input-message-label"
        for="input-message"
        class="pointer-events-none absolute start-0 top-0 h-full truncate border border-transparent p-4 text-slate-500 transition duration-100 ease-in-out peer-not-placeholder-shown:-translate-y-1.5 peer-not-placeholder-shown:text-xs peer-not-placeholder-shown:text-slate-600 peer-focus:-translate-y-1.5 peer-focus:text-xs peer-focus:text-teal-600"
      >
        {formStrings.message}
      </label>
    </div>
  </fieldset>

  {/* Feedback state container */}
  <div id="contact-status" class="hidden mt-4 rounded-lg p-3 text-sm font-medium" role="alert"></div>

  {/* Submit button */}
  <div class="mt-8">
    <button
      type="submit"
      id="contact-submit-btn"
      class="inline-flex items-center justify-center rounded-full bg-btn-gradient px-8 py-3 text-sm font-semibold text-white shadow-sm shadow-blue-500/20 transition-all duration-300 hover:bg-teal-700 hover:shadow-md hover:shadow-blue-500/30 focus:bg-teal-700 focus:outline-hidden disabled:opacity-60 disabled:cursor-not-allowed cursor-pointer"
      aria-label={formStrings.submit}
    >
      <span id="contact-btn-text">{formStrings.submit}</span>
    </button>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('contact-btn-text');

  if (form && statusDiv && submitBtn && btnText) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusDiv.className = 'hidden mt-4 rounded-lg p-3 text-sm font-medium';
      statusDiv.textContent = '';
      submitBtn.disabled = true;
      btnText.textContent = 'Sending...';

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          statusDiv.className = 'mt-4 rounded-lg p-3 text-sm font-medium bg-teal-500/10 text-teal-800 border border-teal-500/20';
          statusDiv.textContent = data.message;
          form.reset();
        } else {
          statusDiv.className = 'mt-4 rounded-lg p-3 text-sm font-medium bg-red-500/10 text-red-700 border border-red-500/20';
          statusDiv.textContent = data.error || 'Failed to submit form. Please try again.';
        }
      } catch (err) {
        statusDiv.className = 'mt-4 rounded-lg p-3 text-sm font-medium bg-red-500/10 text-red-700 border border-red-500/20';
        statusDiv.textContent = 'An error occurred. Please email contact@wellbit.in directly.';
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Send Message';
      }
    });
  }
</script>
