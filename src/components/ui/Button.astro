---
import { twMerge } from 'tailwind-merge';
const { type, href, rel, target, variant, className, id } = Astro.props;

export interface Props {
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  rel?: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  variant?: 'primary' | 'secondary' | 'tertiary';
  className?: string;
  id?: string;
}

const variants = {
  primary:
    'relative group overflow-hidden bg-btn-gradient hover:brightness-105 active:scale-[0.98] text-white shadow-md shadow-blue-600/25 hover:shadow-xl hover:shadow-blue-600/40 font-semibold tracking-wide border border-teal-300/30 hover:-translate-y-0.5 transition-all duration-300',
  secondary:
    'relative group overflow-hidden bg-white hover:bg-slate-50 border border-slate-300 hover:border-teal-500 text-slate-800 hover:text-teal-700 font-semibold shadow-xs hover:shadow-md hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-300',
  tertiary:
    'relative group overflow-hidden bg-teal-50 hover:bg-teal-100/80 text-teal-700 font-semibold border border-teal-200/60 hover:border-teal-300 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200',
};
---

{
  href ? (
    <a
      id={id}
      href={href}
      target={target}
      rel={rel}
      class={twMerge(
        `inline-flex items-center justify-center rounded-full px-7 py-3 text-center text-sm font-semibold transition-all duration-300 focus:outline-hidden ${variants[variant ?? 'primary']} ${className || ''}`
      )}
    >
      <span class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 ease-out group-hover:translate-x-full" />
      <span class="relative z-10 inline-flex items-center gap-2">
        <slot />
      </span>
    </a>
  ) : (
    <button
      id={id}
      type={type || 'button'}
      class={twMerge(
        `inline-flex items-center justify-center rounded-full px-7 py-3 text-center text-sm font-semibold transition-all duration-300 focus:outline-hidden ${variants[variant ?? 'primary']} ${className || ''}`
      )}
    >
      <span class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 ease-out group-hover:translate-x-full" />
      <span class="relative z-10 inline-flex items-center gap-2">
        <slot />
      </span>
    </button>
  )
}
