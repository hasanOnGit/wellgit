---
import SoftwareEngineeringCard from '@common/cards/SoftwareEngineeringCard.astro';
import AiAgentCard from '@common/cards/AiAgentCard.astro';
import BusinessPortalCard from '@common/cards/BusinessPortalCard.astro';
import PlatformOrbit from '@common/PlatformOrbit.astro';

// Content for the section title and subtitle
const title = 'From Complex Requirements to Reliable Software';
const subTitle =
  'We bring together full-stack engineering, system architecture, data management, and automation to build dependable digital products.';

const features = [
  {
    title: 'Enterprise Software',
    description:
      'Modular applications, typed APIs, structured data models, and business-specific workflows designed for maintainability and scale.',
    class: 'relative lg:row-span-2',
    wrapperClass: 'lg:rounded-l-3xl',
    component: SoftwareEngineeringCard,
  },
  {
    title: 'AI-Powered Workflows',
    description:
      'Intelligent assistants, contextual knowledge retrieval, document processing, and automated workflows with appropriate validation and human oversight.',
    class: 'relative max-lg:row-start-1',
    wrapperClass: 'max-lg:rounded-t-3xl',
    component: AiAgentCard,
  },
  {
    title: 'Connected Business Systems',
    description:
      'CRM platforms, HR portals, reporting dashboards, approval systems, and integrations that reduce operational friction.',
    class: 'relative lg:row-span-2',
    wrapperClass: 'max-lg:rounded-b-3xl lg:rounded-r-3xl',
    component: BusinessPortalCard,
  },
  {
    title: 'Production Engineering',
    listItems: [
      'Containerized applications, CI/CD pipelines, and cloud deployments tailored to your project',
      'Operational monitoring, logging, and performance optimization for reliable day-to-day use',
    ],
    class: 'relative max-lg:row-start-3 lg:col-start-2 lg:row-start-2',
    wrapperClass: 'rounded-lg',
    component: PlatformOrbit,
  },
];
---

<div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">
  {/* Section container for the title and subtitle */}
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2
      class="text-2xl font-semibold text-balance text-slate-800 md:text-3xl md:leading-tight"
    >
      {title}
    </h2>
    <p class="mt-3 text-pretty text-slate-600">
      {subTitle}
    </p>
  </div>

  <div class="mx-auto max-w-2xl px-6 lg:max-w-[85rem] lg:px-0">
    <div class="mt-10 grid gap-4 sm:mt-16 lg:grid-cols-3 lg:grid-rows-2">
      {
        features.map(feature => (
          <div class={feature.class}>
            <div
              class={`relative flex h-full flex-col justify-between overflow-hidden rounded-2xl bg-white shadow-xs ${feature.wrapperClass}`}
            >
              <div class="p-8 sm:p-10">
                <h3 class="text-xl font-semibold tracking-tight text-slate-800">
                  {feature.title}
                </h3>
                {feature.description && (
                  <p class="mt-2 max-w-lg text-sm/6 text-slate-600">
                    {feature.description}
                  </p>
                )}

                {feature.listItems && (
                  <ul class="mt-4 list-inside list-disc space-y-2 text-sm/6 text-slate-600 marker:text-teal-600">
                    {feature.listItems.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>

              {/* Render component */}
              {feature.component && (
                <div class="p-4 sm:p-6">
                  <feature.component />
                </div>
              )}

              <div
                class={`pointer-events-none absolute inset-px rounded-2xl shadow-xs ring-1 ring-black/5 ${feature.wrapperClass}`}
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
