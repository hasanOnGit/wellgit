---
import Button from '@ui/Button.astro';

// Content for the section title and subtitle
const title = 'Have a Business Challenge Worth Solving?';
const subTitle =
  "Tell us what you're building, improving, or automating. Let's explore the right technical approach for your goals.";

// Call-to-action configuration for the primary button
const primaryCTA = { text: 'Start a Project Conversation', href: '/contact' };
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
>
  <div class="relative overflow-hidden rounded-3xl bg-cta-gradient border border-slate-200 p-6 sm:p-12 md:p-16 text-center shadow-xs">
    {/* Ambient Siri/Gemini Aurora Backdrop */}
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-72 w-96 rounded-full bg-gradient-to-r from-cyan-400/20 via-indigo-500/15 to-fuchsia-400/20 blur-3xl animate-gemini-glow"></div>

    <div class="mx-auto max-w-3xl relative z-10">
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold tracking-tight text-balance text-slate-800">
        {title}
      </h2>
      <p class="mx-auto mt-3 sm:mt-4 max-w-2xl text-base sm:text-lg/8 text-pretty text-slate-600">
        {subTitle}
      </p>
      <div class="mt-6 sm:mt-8 flex justify-center w-full">
        <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-cyan-400 via-blue-500 via-indigo-500 to-fuchsia-500 bg-[length:200%_auto] animate-siri-border shadow-xl shadow-blue-500/25 hover:shadow-indigo-500/40 hover:scale-[1.02] transition-all duration-300 w-full sm:w-auto">
          <Button
            href={primaryCTA.href}
            variant="primary"
            className="w-full sm:w-auto px-9 py-4 text-base font-bold shadow-none"
          >
            {primaryCTA.text}
            <svg class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
