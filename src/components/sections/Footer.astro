---
import FooterForm from '@ui/forms/FooterForm.astro';
import ContactInfo from '@common/ContactInfo.astro';

// Company information
const companyName = 'Wellbit Technologies';
const companyDescription =
  'Wellbit Technologies engineers custom software, autonomous AI agent pipelines, business workflow automation, and robust web applications for forward-thinking enterprises.';

// Contact information for the company
const contactDetails = {
  company: 'Wellbit Technologies',
  location: 'Global Engineering & Client Delivery',
  email: 'contact@wellbit.in',
  secondaryEmail: 'info@wellbit.in',
  website: 'wellbit.in',
};

// Dynamic date for copyright display
const copyrightYear = new Date().getFullYear();

// Tagline
const tagline = 'Engineering Intelligence. Building Possibilities.';
---

<footer
  class="mt-auto w-full bg-gradient-to-t from-slate-100 via-white to-white pb-10 border-t border-slate-200"
>
  <div class="mx-auto mt-auto w-full max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8">
    <hr class="mb-10 border-slate-200" />

    <div class="grid grid-cols-2 gap-6 md:grid-cols-5">
      {/* Company Information */}
      <div class="col-span-full self-center xl:col-span-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 focus:opacity-80 focus:outline-hidden"
          aria-label="{companyName} Homepage"
        >
          <img
            src="/logo-wellbit-dark.png"
            alt="Wellbit Technologies"
            class="h-8 w-auto"
            loading="lazy"
          />
        </a>
        <p class="mt-4 text-pretty text-slate-600 lg:w-5/12 xl:w-10/12 text-sm leading-relaxed">
          {companyDescription}
        </p>
      </div>

      {/* Contact Information Section */}
      <div class="col-span-1 md:col-span-2 xl:col-span-1 xl:col-start-3">
        <ContactInfo {...contactDetails} />
      </div>

      {/* Email Subscription Form */}
      <div class="col-span-2 md:col-span-3 xl:col-span-2">
        <h3 class="font-semibold text-slate-700">Engineering Updates</h3>
        <FooterForm />
      </div>
    </div>

    {/* Divider before footer's bottom section */}
    <hr class="mt-10 mb-5 border-slate-200" />

    <div
      class="grid gap-y-2 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      {/* Copyright */}
      <p class="text-sm text-slate-500">
        &copy; {copyrightYear} {companyName}. All rights reserved.
      </p>

      {/* Tagline */}
      <p class="text-sm font-medium text-teal-800">
        {tagline}
      </p>
    </div>
  </div>
</footer>
