---
// Interactive & Reactive Tech Stack Matrix for Wellbit Technologies
const techCategories = [
  {
    id: 'ai-agents',
    badge: 'AI & Cognitive Agents',
    title: 'Autonomous Agents & Intelligence Loops',
    description: 'We orchestrate multi-step autonomous agent pipelines that plan, call tools, retrieve context, and execute workflows safely with validation.',
    iconColor: 'from-blue-600 via-teal-500 to-cyan-400',
    tags: ['LangChain', 'LlamaIndex', 'Autonomous Agents', 'RAG Pipelines', 'pgvector', 'Claude & OpenAI APIs'],
    stats: { label: 'Query Latency', value: '< 240ms' },
    svgType: 'neural',
  },
  {
    id: 'fullstack',
    badge: 'Modern Full-Stack',
    title: 'Enterprise Web & Resilient APIs',
    description: 'Sub-second response architectures with end-to-end type safety, modern reactive interfaces, and scalable server-side rendering.',
    iconColor: 'from-teal-600 via-blue-600 to-indigo-500',
    tags: ['TypeScript', 'Astro SSR', 'React 19', 'Next.js', 'Node.js & Bun', 'REST & GraphQL'],
    stats: { label: 'Lighthouse Score', value: '99/100' },
    svgType: 'fullstack',
  },
  {
    id: 'data',
    badge: 'Data & Persistence',
    title: 'Distributed Storage & Vector Search',
    description: 'High-concurrency data persistence combining relational ACID transactions, distributed document databases, and millisecond caching.',
    iconColor: 'from-sky-500 via-teal-500 to-indigo-600',
    tags: ['PostgreSQL', 'MongoDB Atlas', 'Redis In-Memory', 'Kafka Streams', 'Vector Embeddings'],
    stats: { label: 'Data Concurrency', value: '100k+ ops/s' },
    svgType: 'database',
  },
  {
    id: 'cloud',
    badge: 'Cloud & DevOps',
    title: 'Containerized Edge & Zero Lock-in',
    description: 'Zero-downtime deployment pipelines with automated regression testing, immutable container images, and continuous telemetry.',
    iconColor: 'from-indigo-600 via-blue-600 to-cyan-600',
    tags: ['Docker', 'Kubernetes', 'AWS & Cloudflare', 'Terraform IaC', 'OpenTelemetry', 'CI/CD Pipelines'],
    stats: { label: 'Target Availability', value: '99.99%' },
    svgType: 'cloud',
  },
  {
    id: 'sap',
    badge: 'Enterprise SAP & ERP',
    title: 'Digital Core, BTP & Clean Extensions',
    description: 'Modernize enterprise workflows with S/4HANA transitions, SAP BTP Integration Suite, modern Fiori experiences, and decoupled Clean Core architectures.',
    iconColor: 'from-amber-600 via-orange-500 to-yellow-500',
    tags: ['SAP S/4HANA', 'SAP BTP', 'Fiori / SAPUI5', 'Integration Suite (CPI)', 'ABAP RAP / CDS', 'SAP Analytics Cloud'],
    stats: { label: 'Architecture Standard', value: 'Clean Core' },
    svgType: 'sap',
  },
];
---

<section id="tech-matrix-section" class="relative overflow-hidden bg-gradient-to-b from-white via-slate-50 to-white py-16 sm:py-24 border-y border-slate-200">
  {/* Ambient animated background glows */}
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-teal-200/30 blur-3xl animate-pulse-glow"></div>
  <div class="pointer-events-none absolute bottom-0 right-10 -z-10 h-80 w-80 rounded-full bg-blue-100/40 blur-3xl animate-float"></div>

  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
    {/* Section Header */}
    <div class="mx-auto max-w-3xl text-center mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-x-2 rounded-full border border-teal-200 bg-teal-50 px-3.5 py-1 text-xs font-semibold text-teal-800 shadow-2xs mb-4">
        <span class="inline-block size-2 rounded-full bg-teal-500 animate-ping"></span>
        Engineered for Production Scale
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl md:text-5xl font-display">
        The Wellbit Engineering Stack & Ecosystem
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        We select and master enterprise technologies built for longevity, verifiable security, sub-second latency, and zero vendor lock-in.
      </p>

      {/* Reactive Domain Filter Tabs */}
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        <button
          type="button"
          data-filter="all"
          class="matrix-filter-btn active rounded-full px-4 py-2 text-xs font-bold transition-all duration-300 shadow-xs cursor-pointer bg-slate-900 text-white ring-2 ring-slate-900"
        >
          ✨ All Domains
        </button>
        <button
          type="button"
          data-filter="ai-agents"
          class="matrix-filter-btn rounded-full px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:border-teal-400 hover:text-teal-700 transition-all duration-300 shadow-2xs cursor-pointer"
        >
          🧠 AI & Autonomous Agents
        </button>
        <button
          type="button"
          data-filter="fullstack"
          class="matrix-filter-btn rounded-full px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:border-teal-400 hover:text-teal-700 transition-all duration-300 shadow-2xs cursor-pointer"
        >
          ⚡ Modern Full-Stack
        </button>
        <button
          type="button"
          data-filter="data"
          class="matrix-filter-btn rounded-full px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:border-teal-400 hover:text-teal-700 transition-all duration-300 shadow-2xs cursor-pointer"
        >
          💾 Data & Persistence
        </button>
        <button
          type="button"
          data-filter="cloud"
          class="matrix-filter-btn rounded-full px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:border-teal-400 hover:text-teal-700 transition-all duration-300 shadow-2xs cursor-pointer"
        >
          ☁️ Cloud & DevOps
        </button>
        <button
          type="button"
          data-filter="sap"
          class="matrix-filter-btn rounded-full px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:border-amber-400 hover:text-amber-800 transition-all duration-300 shadow-2xs cursor-pointer"
        >
          🏢 Enterprise SAP & ERP
        </button>
      </div>
    </div>

    {/* Tech Categories Grid with Reactive Cards */}
    <div id="matrix-cards-container" class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        techCategories.map((cat, idx) => (
          <div
            data-category-card={cat.id}
            class="matrix-card group relative flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs transition-all duration-500 hover:-translate-y-2 hover:border-teal-400 hover:shadow-2xl hover:shadow-teal-900/10"
          >
            {/* Top decorative gradient bar */}
            <div class={`absolute inset-x-0 top-0 h-1.5 rounded-t-2xl bg-gradient-to-r ${cat.iconColor}`}></div>

            <div>
              {/* Badge & Mini Graphic Header */}
              <div class="flex items-center justify-between mb-4">
                <span class="inline-block rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 group-hover:bg-teal-50 group-hover:text-teal-800 transition-colors">
                  {cat.badge}
                </span>
                <span class="font-mono text-xs font-semibold text-teal-700 bg-teal-50 border border-teal-200/60 rounded px-2 py-0.5">
                  0{idx + 1}
                </span>
              </div>

              {/* Bespoke Tech Illustration SVG with Animated Pulses */}
              <div class="mb-5 flex h-28 w-full items-center justify-center rounded-xl bg-gradient-to-b from-slate-50 to-slate-100/60 border border-slate-200/60 p-2 overflow-hidden group-hover:border-teal-200 group-hover:bg-teal-50/30 transition-all">
                {cat.svgType === 'neural' && (
                  <svg class="h-20 w-full text-teal-600" viewBox="0 0 200 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="30" cy="45" r="8" class="fill-teal-100 stroke-teal-600" stroke-width="2" />
                    <circle cx="80" cy="22" r="7" class="fill-sky-100 stroke-sky-500" stroke-width="2" />
                    <circle cx="80" cy="68" r="7" class="fill-sky-100 stroke-sky-500" stroke-width="2" />
                    <circle cx="130" cy="22" r="7" class="fill-blue-100 stroke-blue-600" stroke-width="2" />
                    <circle cx="130" cy="68" r="7" class="fill-blue-100 stroke-blue-600" stroke-width="2" />
                    <circle cx="175" cy="45" r="9" class="fill-teal-500 stroke-teal-700" stroke-width="2" />
                    {/* Connections */}
                    <path d="M38 45 L73 24 M38 45 L73 66" stroke="#94a3b8" stroke-dasharray="3 3" stroke-width="1.5" />
                    <path d="M87 22 L123 22 M87 22 L123 66" stroke="#38bdf8" stroke-width="1.5" />
                    <path d="M87 68 L123 24 M87 68 L123 68" stroke="#38bdf8" stroke-width="1.5" />
                    <path d="M137 24 L167 43 M137 66 L167 47" stroke="#1768e8" stroke-width="2" />
                    <circle cx="80" cy="22" r="3" class="fill-teal-600 animate-ping" />
                    <circle cx="175" cy="45" r="4" class="fill-white" />
                  </svg>
                )}

                {cat.svgType === 'fullstack' && (
                  <svg class="h-20 w-full text-blue-600" viewBox="0 0 200 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="25" y="10" width="150" height="70" rx="8" class="fill-white stroke-slate-300" stroke-width="1.5" />
                    <rect x="25" y="10" width="150" height="16" rx="8" class="fill-slate-100" />
                    <circle cx="37" cy="18" r="2.5" fill="#ef4444" />
                    <circle cx="46" cy="18" r="2.5" fill="#f59e0b" />
                    <circle cx="55" cy="18" r="2.5" fill="#10b981" />
                    <rect x="40" y="36" width="55" height="6" rx="3" class="fill-teal-500" />
                    <rect x="40" y="48" width="80" height="4" rx="2" class="fill-slate-300" />
                    <rect x="40" y="58" width="60" height="4" rx="2" class="fill-slate-200" />
                    <rect x="115" y="36" width="45" height="30" rx="4" class="fill-teal-50 stroke-teal-200" stroke-width="1" />
                    <path d="M125 51 L133 59 L150 43" stroke="#1768e8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}

                {cat.svgType === 'database' && (
                  <svg class="h-20 w-full text-sky-600" viewBox="0 0 200 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g transform="translate(45, 12)">
                      <ellipse cx="55" cy="14" rx="40" ry="10" class="fill-teal-100 stroke-teal-600" stroke-width="1.5" />
                      <path d="M15 14 v20 c0 6 18 10 40 10 s40 -4 40 -10 v-20" class="fill-teal-50/50 stroke-teal-600" stroke-width="1.5" />
                      <path d="M15 34 v20 c0 6 18 10 40 10 s40 -4 40 -10 v-20" class="fill-white stroke-teal-600" stroke-width="1.5" />
                      <circle cx="55" cy="50" r="3" class="fill-teal-600 animate-pulse" />
                      <line x1="65" y1="50" x2="82" y2="50" stroke="#0b1730" stroke-width="1.5" stroke-linecap="round" />
                    </g>
                  </svg>
                )}

                {cat.svgType === 'cloud' && (
                  <svg class="h-20 w-full text-indigo-600" viewBox="0 0 200 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M82 55 C72 55 64 47 64 38 C64 30 70 23 78 22 C82 14 90 8 100 8 C112 8 122 16 124 26 C130 26 136 31 136 38 C136 45 130 55 120 55 Z" class="fill-blue-50 stroke-blue-500" stroke-width="1.5" />
                    <rect x="35" y="65" width="30" height="15" rx="3" class="fill-white stroke-slate-300" stroke-width="1.2" />
                    <rect x="85" y="65" width="30" height="15" rx="3" class="fill-teal-50 stroke-teal-400" stroke-width="1.2" />
                    <rect x="135" y="65" width="30" height="15" rx="3" class="fill-white stroke-slate-300" stroke-width="1.2" />
                    <path d="M50 65 L80 55 M100 65 L100 55 M150 65 L120 55" stroke="#94a3b8" stroke-width="1.2" stroke-dasharray="2 2" />
                    <circle cx="100" cy="72" r="2" class="fill-teal-600 animate-ping" />
                  </svg>
                )}

                {cat.svgType === 'sap' && (
                  <svg class="h-20 w-full text-amber-600" viewBox="0 0 200 90" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="16" y="24" width="46" height="42" rx="6" class="fill-amber-50 stroke-amber-500" stroke-width="1.5" />
                    <text x="39" y="48" text-anchor="middle" class="fill-amber-950 text-[9px] font-bold font-mono">S/4HANA</text>
                    <path d="M62 45 L90 45" stroke="#f59e0b" stroke-width="2" stroke-dasharray="3 3" />
                    <circle cx="76" cy="45" r="3" class="fill-amber-500 animate-ping" />
                    <rect x="90" y="18" width="50" height="52" rx="8" class="fill-teal-50 stroke-teal-500" stroke-width="1.5" />
                    <text x="115" y="41" text-anchor="middle" class="fill-teal-950 text-[9px] font-extrabold font-mono">BTP</text>
                    <text x="115" y="55" text-anchor="middle" class="fill-teal-700 text-[8px] font-mono">CPI / RAP</text>
                    <path d="M140 45 L158 45" stroke="#0d9488" stroke-width="2" />
                    <rect x="158" y="24" width="30" height="42" rx="4" class="fill-blue-50 stroke-blue-500" stroke-width="1.2" />
                    <rect x="162" y="30" width="22" height="15" rx="2" class="fill-blue-100" />
                    <line x1="166" y1="52" x2="180" y2="52" stroke="#1e40af" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                )}
              </div>

              {/* Title & Description */}
              <h3 class="text-lg font-bold text-slate-800 font-display group-hover:text-teal-700 transition-colors">
                {cat.title}
              </h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                {cat.description}
              </p>

              {/* Reactive Tech Badges */}
              <div class="mt-4 flex flex-wrap gap-1.5">
                {cat.tags.map(t => (
                  <span class="inline-flex items-center rounded-md bg-slate-50 border border-slate-200/80 px-2 py-0.5 text-[11px] font-medium text-slate-700 transition-all duration-200 hover:border-teal-400 hover:bg-teal-50 hover:text-teal-800 hover:scale-105 cursor-default">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            {/* Bottom KPI */}
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500">{cat.stats.label}</span>
              <span class="font-bold text-teal-700 font-mono text-sm">{cat.stats.value}</span>
            </div>
          </div>
        ))
      }
    </div>

    {/* Architecture Guarantee Footer Banner with Interactive CTA */}
    <div class="mt-12 rounded-2xl bg-gradient-to-r from-navy via-slate-900 to-navy p-6 sm:p-8 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 border border-slate-800">
      <div class="flex items-center gap-4">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-teal-500/20 text-teal-300 border border-teal-400/30 animate-pulse-glow">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <div>
          <h4 class="text-base sm:text-lg font-bold font-display">100% Client Code Ownership & Zero Lock-in Guarantee</h4>
          <p class="text-xs sm:text-sm text-slate-300 mt-1">Every repository, database schema, and deployment script is handed over with comprehensive documentation and standard tooling.</p>
        </div>
      </div>
      <a
        href="/contact"
        class="shrink-0 group relative overflow-hidden inline-flex items-center gap-x-2 rounded-full bg-btn-gradient px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-teal-500/25 hover:shadow-teal-500/40 hover:-translate-y-0.5 active:scale-95 transition-all duration-300"
      >
        <span class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 ease-out group-hover:translate-x-full" />
        <span class="relative z-10 flex items-center gap-2">
          Consult With Engineers
          <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const filterBtns = document.querySelectorAll('.matrix-filter-btn');
    const cards = document.querySelectorAll('.matrix-card');

    if (!filterBtns.length || !cards.length) return;

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active tab styles
        filterBtns.forEach(b => {
          b.className = 'matrix-filter-btn rounded-full px-4 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:border-teal-400 hover:text-teal-700 transition-all duration-300 shadow-2xs cursor-pointer';
        });
        btn.className = 'matrix-filter-btn active rounded-full px-4 py-2 text-xs font-bold transition-all duration-300 shadow-xs cursor-pointer bg-slate-900 text-white ring-2 ring-slate-900';

        // Animate cards
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category-card');
          if (filter === 'all' || cardCat === filter) {
            card.classList.remove('opacity-30', 'scale-95');
            card.classList.add('opacity-100', 'scale-100');
            if (cardCat === filter) {
              card.classList.add('ring-2', 'ring-teal-500', 'shadow-2xl');
            } else {
              card.classList.remove('ring-2', 'ring-teal-500');
            }
          } else {
            card.classList.remove('ring-2', 'ring-teal-500');
            card.classList.add('opacity-30', 'scale-95');
          }
        });
      });
    });
  });
</script>
