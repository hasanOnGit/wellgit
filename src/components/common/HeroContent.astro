---
import Button from '@ui/Button.astro';

const title = 'Engineering Intelligence. Building Possibilities.';
const subTitle =
  'Wellbit builds custom software, AI-powered solutions, and scalable digital platforms that help businesses automate operations, solve complex challenges, and accelerate growth.';
const primaryCTA = {
  text: "Let's Discuss Your Project",
  href: '/contact',
};
const secondaryCTA = {
  text: 'Explore Our Capabilities',
  href: '/platform',
};
---

{/* Hero Content Container with Reference Accents */}
<div class="relative mx-auto max-w-5xl text-center select-none pt-2">
  {/* Headline with Floating Colorful Accents (Reference Alignment) */}
  <div class="relative mx-auto inline-block max-w-4xl px-2 sm:px-0">
    <!-- Soft Sky Petal Accent (Left of Headline) -->
    <div class="pointer-events-none absolute -top-4 -left-12 hidden lg:block transform -rotate-12 transition-transform duration-700 hover:rotate-0 opacity-40">
      <svg class="h-10 w-8 drop-shadow-xs" viewBox="0 0 40 56" fill="#3896F5">
        <path d="M0 28C0 12.536 12.536 0 28 0C34.627 0 40 5.373 40 12C40 27.464 27.464 40 12 40C5.373 40 0 34.627 0 28Z"></path>
      </svg>
    </div>

    <!-- Soft Icy Hexagon Accent (Top Center above Headline) -->
    <div class="pointer-events-none absolute -top-10 left-1/2 -translate-x-1/2 hidden lg:block opacity-35">
      <svg class="h-8 w-8 drop-shadow-xs" viewBox="0 0 32 32" fill="#B9D9FF">
        <path d="M16 2L28 9V23L16 30L4 23V9L16 2Z"></path>
      </svg>
    </div>

    <!-- Brand Cyan-Blue Leaf Accent (Right of Headline - Wellbit Identity) -->
    <div class="pointer-events-none absolute -top-4 -right-12 hidden lg:block transform rotate-12 transition-transform duration-700 hover:rotate-45 opacity-40">
      <svg class="h-10 w-8 drop-shadow-xs" viewBox="0 0 40 56" fill="#00BFFC">
        <path d="M40 28C40 12.536 27.464 0 12 0C5.373 0 0 5.373 0 12C0 27.464 12.536 40 28 40C34.627 40 40 34.627 40 28Z"></path>
      </svg>
    </div>

    <!-- Subtle Blue Ring Accent (Mid Right) -->
    <div class="pointer-events-none absolute top-1/2 -right-16 hidden lg:block opacity-40">
      <div class="h-3.5 w-3.5 rounded-full bg-teal-500 ring-2 ring-teal-300/40"></div>
    </div>

    <h1
      class="block text-3xl font-bold tracking-tight text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl leading-tight sm:leading-tight md:leading-tight"
    >
      {title}
    </h1>
  </div>
</div>

<div class="mx-auto max-w-3xl text-center mt-4 sm:mt-6 mb-6 sm:mb-8 px-2 sm:px-0">
  <p class="text-base sm:text-xl font-normal leading-relaxed text-pretty text-slate-600">
    {subTitle}
  </p>
</div>

{/* CTA Buttons with Modern Pill Shape */}
<div class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-4 w-full sm:w-auto px-4 sm:px-0">
  <Button href={primaryCTA.href} variant="primary" className="w-full sm:w-auto px-7 py-3 sm:px-8 sm:py-3.5 text-sm sm:text-base font-semibold shadow-md shadow-teal-600/25">
    {primaryCTA.text}
  </Button>
  <Button href={secondaryCTA.href} variant="secondary" className="w-full sm:w-auto px-7 py-3 sm:px-8 sm:py-3.5 text-sm sm:text-base font-semibold">
    {secondaryCTA.text}
  </Button>
</div>
