---
import { STARTER_PROMPTS } from '@data/chatbotKnowledge';
---

<div id="wellbit-ai-chatbot-root" class="select-none">
  {/* Ambient Notification Callout / Tooltip */}
  <div
    id="ai-chatbot-tooltip"
    class="fixed bottom-24 right-6 z-50 hidden sm:flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-white/95 backdrop-blur-xl border border-slate-200/90 shadow-xl shadow-slate-900/10 text-xs font-semibold text-slate-800 transition-all duration-300 opacity-0 translate-y-2 pointer-events-none"
  >
    <span class="flex size-2 relative">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full size-2 bg-teal-500"></span>
    </span>
    <span>Have a question? <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-500 via-blue-600 to-fuchsia-600">Ask Nova ✦</span></span>
  </div>

  {/* Floating Trigger Button with Siri/Gemini Luminous Halo */}
  <div class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50">
    <button
      id="ai-chatbot-toggle"
      type="button"
      aria-label="Open Nova AI Assistant"
      class="group relative flex items-center justify-center size-14 sm:size-15 rounded-full p-[2px] bg-gradient-to-r from-cyan-400 via-blue-500 via-indigo-500 to-fuchsia-500 bg-[length:200%_auto] animate-siri-border shadow-2xl shadow-blue-500/30 hover:shadow-indigo-500/50 hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-hidden"
    >
      {/* Background ambient glow halo */}
      <span class="pointer-events-none absolute -inset-2 rounded-full bg-gradient-to-r from-cyan-400/40 via-indigo-500/40 to-pink-500/40 blur-lg animate-gemini-glow opacity-80 group-hover:opacity-100 transition-opacity"></span>

      {/* Button Interior */}
      <span class="relative flex items-center justify-center size-full rounded-full bg-slate-950 text-white transition-colors">
        {/* Closed State Icon: AI Sparkles & Chat */}
        <span id="ai-toggle-open-icon" class="flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
          <svg class="size-6 text-cyan-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </span>

        {/* Opened State Icon: Close X */}
        <span id="ai-toggle-close-icon" class="hidden items-center justify-center transition-transform duration-300">
          <svg class="size-6 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </span>

        {/* Unread dot */}
        <span id="ai-unread-dot" class="absolute top-1 right-1 flex size-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full size-3 bg-cyan-400 border-2 border-slate-950"></span>
        </span>
      </span>
    </button>
  </div>

  {/* Chat Window Modal */}
  <div
    id="ai-chatbot-window"
    role="dialog"
    aria-label="Nova AI Assistant"
    class="fixed bottom-22 sm:bottom-25 right-3 sm:right-6 z-50 hidden flex-col w-[calc(100vw-1.5rem)] sm:w-[420px] h-[580px] max-h-[82vh] rounded-3xl bg-white/95 backdrop-blur-2xl border border-slate-200/90 shadow-[0_25px_60px_-15px_rgba(7,16,36,0.25)] ring-1 ring-slate-900/5 overflow-hidden transition-all duration-300 origin-bottom-right"
  >
    {/* Header */}
    <div class="relative flex items-center justify-between px-4 sm:px-5 py-3.5 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 text-white border-b border-slate-800/80">
      {/* Siri Ambient Aurora Header Glow */}
      <div class="pointer-events-none absolute -top-10 left-1/4 -z-0 h-24 w-48 rounded-full bg-gradient-to-r from-cyan-500/20 via-indigo-500/20 to-fuchsia-500/20 blur-xl animate-siri-border bg-[length:200%_auto]"></div>

      <div class="relative z-10 flex items-center gap-3">
        {/* Avatar with chromatic ring */}
        <div class="relative flex items-center justify-center size-9.5 rounded-full p-[1.5px] bg-gradient-to-tr from-cyan-400 via-blue-500 to-fuchsia-500 animate-siri-border bg-[length:200%_auto]">
          <div class="flex items-center justify-center size-full rounded-full bg-slate-900 text-cyan-300 font-bold text-xs">
            ✦
          </div>
          <span class="absolute -bottom-0.5 -right-0.5 size-2.5 rounded-full bg-teal-400 ring-2 ring-slate-900"></span>
        </div>

        <div>
          <div class="flex items-center gap-1.5">
            <h3 class="font-display font-bold text-sm tracking-tight text-white">Nova</h3>
            <span class="text-[10px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-cyan-400/15 text-cyan-300 border border-cyan-400/20 font-semibold">✦ Wellbit AI</span>
          </div>
          <p class="text-[11px] text-slate-300 flex items-center gap-1 font-medium">
            <span class="inline-block size-1.5 rounded-full bg-teal-400 animate-pulse"></span>
            Online • Instant answers & routing
          </p>
        </div>
      </div>

      {/* Header Actions */}
      <div class="relative z-10 flex items-center gap-1">
        {/* Reset / Clear Chat */}
        <button
          id="ai-clear-chat"
          type="button"
          title="Clear Conversation"
          aria-label="Clear Conversation"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition-colors cursor-pointer"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
        </button>

        {/* Close Modal */}
        <button
          id="ai-close-modal"
          type="button"
          aria-label="Close Chat"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/70 transition-colors cursor-pointer"
        >
          <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    {/* Messages Scroll Area */}
    <div
      id="ai-messages-container"
      class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4 scroll-smooth select-text text-sm"
    >
      {/* Welcome Message Card */}
      <div id="ai-welcome-card" class="flex gap-2.5 items-start">
        <div class="shrink-0 size-7 rounded-full bg-gradient-to-tr from-cyan-400 to-indigo-600 flex items-center justify-center text-white text-[11px] font-bold shadow-xs">
          ✦
        </div>
        <div class="flex-1 space-y-2">
          <div class="p-3.5 rounded-2xl rounded-tl-xs bg-slate-100/80 border border-slate-200/80 text-slate-800 leading-relaxed shadow-2xs">
            <p class="font-medium text-slate-900 mb-1">
              Hey there! I'm <strong class="text-indigo-600">Nova</strong> 👋
            </p>
            <p class="text-slate-600 text-[13px] leading-relaxed">
              I'm your engineering copilot at Wellbit. Ask me anything about our custom software development, mobile & web apps, cloud infrastructure, or enterprise AI—I'll give you exact answers and direct links to get started!
            </p>
          </div>

          {/* Quick starter questions */}
          <div class="pt-1">
            <p class="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-semibold mb-2">
              Popular questions:
            </p>
            <div class="flex flex-wrap gap-1.5" id="ai-starter-prompts-list">
              {
                STARTER_PROMPTS.map((prompt: string) => (
                  <button
                    type="button"
                    class="ai-prompt-chip text-left text-xs px-2.5 py-1.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:border-cyan-400 hover:bg-cyan-50/50 hover:text-slate-900 transition-all shadow-2xs cursor-pointer"
                    data-prompt={prompt}
                  >
                    {prompt}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Thinking / Typing Animation Bar */}
    <div id="ai-typing-indicator" class="hidden px-5 py-2">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 text-xs font-medium">
        <span class="flex items-center gap-1">
          <span class="size-1.5 rounded-full bg-cyan-500 animate-bounce"></span>
          <span class="size-1.5 rounded-full bg-indigo-500 animate-bounce [animation-delay:0.2s]"></span>
          <span class="size-1.5 rounded-full bg-pink-500 animate-bounce [animation-delay:0.4s]"></span>
        </span>
        <span>Nova is formulating answer...</span>
      </div>
    </div>

    {/* Input Area */}
    <div class="p-3 sm:p-4 bg-white/90 border-t border-slate-200/80">
      <form id="ai-chat-form" class="flex items-center gap-2">
        <div class="relative flex-1">
          <input
            id="ai-user-input"
            type="text"
            autocomplete="off"
            placeholder="Ask Nova about services, AI, quotes, tech stack..."
            class="w-full pl-3.5 pr-3 py-2.5 text-xs sm:text-sm rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:outline-hidden focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/20 transition-all"
          />
        </div>

        <button
          id="ai-submit-button"
          type="submit"
          aria-label="Send message"
          class="shrink-0 flex items-center justify-center size-10 rounded-xl bg-btn-gradient text-white hover:opacity-95 active:scale-95 transition-all shadow-md shadow-blue-500/20 disabled:opacity-40 disabled:pointer-events-none cursor-pointer"
        >
          <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </button>
      </form>

      <div class="mt-2 flex items-center justify-between text-[10px] text-slate-400 px-1 font-mono">
        <span>Instant answers & route links</span>
        <span>Press <kbd class="px-1 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-600 font-sans">Enter</kbd></span>
      </div>
    </div>
  </div>
</div>

<script>
  import { findBestAnswer, type RouteAction } from '@data/chatbotKnowledge';

  interface ChatMessage {
    id: string;
    sender: 'user' | 'assistant';
    text: string;
    routes?: RouteAction[];
    followUps?: string[];
    timestamp: string;
  }

  const STORAGE_KEY = 'wellbit_ai_chat_history_v2';
  const SEEN_TOOLTIP_KEY = 'wellbit_ai_tooltip_dismissed_v2';

  function initChatbot() {
    const root = document.getElementById('wellbit-ai-chatbot-root');
    if (!root) return;

    // Prevent duplicate event listener registration if already initialized on this DOM element
    if (root.dataset.initialized === 'true') {
      return;
    }
    root.dataset.initialized = 'true';

    const toggleBtn = document.getElementById('ai-chatbot-toggle');
    const closeBtn = document.getElementById('ai-close-modal');
    const clearBtn = document.getElementById('ai-clear-chat');
    const windowEl = document.getElementById('ai-chatbot-window');
    const openIcon = document.getElementById('ai-toggle-open-icon');
    const closeIcon = document.getElementById('ai-toggle-close-icon');
    const unreadDot = document.getElementById('ai-unread-dot');
    const tooltipEl = document.getElementById('ai-chatbot-tooltip');
    const chatForm = document.getElementById('ai-chat-form') as HTMLFormElement | null;
    const userInput = document.getElementById('ai-user-input') as HTMLInputElement | null;
    const submitBtn = document.getElementById('ai-submit-button') as HTMLButtonElement | null;
    const messagesContainer = document.getElementById('ai-messages-container');
    const typingIndicator = document.getElementById('ai-typing-indicator');

    if (!toggleBtn || !windowEl || !messagesContainer) return;

    let isOpen = false;
    let isSubmitting = false;
    let messages: ChatMessage[] = [];

    // Load saved conversation
    try {
      const saved = sessionStorage.getItem(STORAGE_KEY);
      if (saved) {
        messages = JSON.parse(saved);
      }
    } catch {
      messages = [];
    }

    // Render loaded messages
    function renderMessages() {
      if (!messagesContainer) return;

      // Keep welcome card intact (first child)
      const welcomeBlock = document.getElementById('ai-welcome-card');
      messagesContainer.innerHTML = '';
      if (welcomeBlock) {
        messagesContainer.appendChild(welcomeBlock);
      }

      messages.forEach(msg => {
        appendMessageElement(msg);
      });

      scrollToBottom();
    }

    function scrollToBottom() {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    function formatMarkdown(text: string): string {
      let formatted = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Bold text **text**
      formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-950">$1</strong>');

      // Markdown links [text](url)
      formatted = formatted.replace(
        /\[(.*?)\]\((.*?)\)/g,
        '<a href="$2" class="font-semibold text-blue-600 underline underline-offset-2 hover:text-blue-700 transition-colors">$1</a>'
      );

      // Bullet points
      formatted = formatted.replace(/^\s*-\s+(.+)$/gm, '<li class="ml-4 list-disc text-slate-700 my-0.5">$1</li>');

      // Line breaks
      formatted = formatted.replace(/\n\n/g, '<div class="h-2"></div>');
      formatted = formatted.replace(/\n/g, '<br/>');

      return formatted;
    }

    function appendMessageElement(msg: ChatMessage) {
      if (!messagesContainer) return;

      const row = document.createElement('div');
      row.className = `flex gap-2.5 items-start ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`;

      if (msg.sender === 'assistant') {
        const avatar = document.createElement('div');
        avatar.className = 'shrink-0 size-7 rounded-full bg-gradient-to-tr from-cyan-400 to-indigo-600 flex items-center justify-center text-white text-[11px] font-bold shadow-xs';
        avatar.textContent = '✦';
        row.appendChild(avatar);
      }

      const contentBox = document.createElement('div');
      contentBox.className = `max-w-[85%] space-y-2.5 ${msg.sender === 'user' ? 'items-end' : 'items-start'}`;

      const bubble = document.createElement('div');
      if (msg.sender === 'user') {
        bubble.className = 'px-4 py-2.5 rounded-2xl rounded-tr-xs bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-[13px] leading-relaxed shadow-xs';
        bubble.textContent = msg.text;
      } else {
        bubble.className = 'p-3.5 rounded-2xl rounded-tl-xs bg-slate-100/90 border border-slate-200/80 text-slate-800 text-[13px] leading-relaxed shadow-2xs';
        bubble.innerHTML = formatMarkdown(msg.text);
      }

      contentBox.appendChild(bubble);

      // Render Route Navigation Action Buttons
      if (msg.routes && msg.routes.length > 0) {
        const routesWrap = document.createElement('div');
        routesWrap.className = 'flex flex-wrap gap-1.5 pt-0.5';

        msg.routes.forEach(route => {
          const btn = document.createElement('a');
          btn.href = route.href;
          btn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-teal-200/90 text-teal-800 hover:border-blue-500 hover:text-blue-600 hover:shadow-xs text-xs font-semibold transition-all group/route';
          btn.innerHTML = `
            <span>${route.label}</span>
            <svg class="size-3 text-teal-600 group-hover/route:text-blue-600 group-hover/route:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          `;
          routesWrap.appendChild(btn);
        });

        contentBox.appendChild(routesWrap);
      }

      // Render Follow-up Suggestions
      if (msg.followUps && msg.followUps.length > 0) {
        const followUpsWrap = document.createElement('div');
        followUpsWrap.className = 'flex flex-wrap gap-1 pt-1';

        msg.followUps.forEach(followUp => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'text-left text-[11px] px-2 py-1 rounded-lg bg-slate-50 border border-slate-200/80 text-slate-600 hover:border-cyan-400 hover:bg-cyan-50/50 hover:text-slate-900 transition-all cursor-pointer';
          chip.textContent = `↳ ${followUp}`;
          chip.addEventListener('click', (e) => {
            e.stopPropagation();
            handleUserSubmit(followUp);
          }, { once: true });
          followUpsWrap.appendChild(chip);
        });

        contentBox.appendChild(followUpsWrap);
      }

      row.appendChild(contentBox);
      messagesContainer.appendChild(row);
      scrollToBottom();
    }

    function toggleChat(state?: boolean) {
      isOpen = state !== undefined ? state : !isOpen;

      if (isOpen) {
        windowEl?.classList.remove('hidden');
        windowEl?.classList.add('flex');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        closeIcon?.classList.add('flex');
        unreadDot?.classList.add('hidden');
        tooltipEl?.classList.add('opacity-0', 'pointer-events-none');
        sessionStorage.setItem(SEEN_TOOLTIP_KEY, 'true');

        setTimeout(() => {
          userInput?.focus();
          scrollToBottom();
        }, 100);
      } else {
        windowEl?.classList.add('hidden');
        windowEl?.classList.remove('flex');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        closeIcon?.classList.remove('flex');
      }
    }

    async function handleUserSubmit(text: string) {
      // Guard against double submission
      if (isSubmitting) return;
      const query = text.trim();
      if (!query) return;

      isSubmitting = true;
      if (submitBtn) submitBtn.disabled = true;

      try {
        // Add user message
        const userMsg: ChatMessage = {
          id: `user-${Date.now()}`,
          sender: 'user',
          text: query,
          timestamp: new Date().toISOString(),
        };

        messages.push(userMsg);
        appendMessageElement(userMsg);
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(messages));

        if (userInput) userInput.value = '';

        // Show typing indicator
        if (typingIndicator) typingIndicator.classList.remove('hidden');
        scrollToBottom();

        // Instant evaluation via bundled knowledge engine (avoids 308 redirects & server latency)
        const data = findBestAnswer(query);

        // Simulate thoughtful typing response
        await new Promise(resolve => setTimeout(resolve, 380));

        if (typingIndicator) typingIndicator.classList.add('hidden');

        const assistantMsg: ChatMessage = {
          id: `assistant-${Date.now()}`,
          sender: 'assistant',
          text: data.answer,
          routes: data.routes || [],
          followUps: data.followUps || [],
          timestamp: new Date().toISOString(),
        };

        messages.push(assistantMsg);
        appendMessageElement(assistantMsg);
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(messages));
      } finally {
        isSubmitting = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    // Attach event listeners safely
    toggleBtn.addEventListener('click', () => toggleChat());
    closeBtn?.addEventListener('click', () => toggleChat(false));

    clearBtn?.addEventListener('click', () => {
      messages = [];
      sessionStorage.removeItem(STORAGE_KEY);
      renderMessages();
    });

    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (userInput && userInput.value.trim()) {
        handleUserSubmit(userInput.value);
      }
    });

    // Starter prompt chips delegation
    const promptsList = document.getElementById('ai-starter-prompts-list');
    promptsList?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.ai-prompt-chip') as HTMLElement | null;
      if (target) {
        const prompt = target.getAttribute('data-prompt');
        if (prompt) {
          handleUserSubmit(prompt);
        }
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleChat(false);
      }
    });

    // Tooltip entrance on first load after 3 seconds
    if (!sessionStorage.getItem(SEEN_TOOLTIP_KEY)) {
      setTimeout(() => {
        if (!isOpen && tooltipEl) {
          tooltipEl.classList.remove('hidden', 'opacity-0', 'translate-y-2');
          tooltipEl.classList.add('opacity-100', 'translate-y-0');

          // Auto-hide tooltip after 8 seconds
          setTimeout(() => {
            tooltipEl.classList.remove('opacity-100', 'translate-y-0');
            tooltipEl.classList.add('opacity-0', 'translate-y-2');
          }, 8000);
        }
      }, 3000);
    }

    // Initial render of existing history
    renderMessages();
  }

  // Bind to astro:page-load for View Transitions and standard page loads
  document.addEventListener('astro:page-load', initChatbot);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initChatbot();
  }
</script>
