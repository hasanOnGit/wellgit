---
import Icon from '@ui/icons/Icon.astro';
const { company, email, phone, secondaryEmail, website, location } = Astro.props;
---

<div>
  <h3 class="font-semibold text-slate-700">Contact & Inquiries</h3>
  <ul class="mt-3 space-y-2.5 text-sm text-slate-600">
    <li class="font-medium text-slate-800">{company || 'Wellbit Technologies'}</li>
    <li>{location || 'Global Engineering & Client Delivery'}</li>
    {phone && (
      <li class="flex items-center gap-x-2">
        <svg class="size-4 shrink-0 text-teal-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <a
          href={`tel:${phone.replace(/\s+/g, '')}`}
          class="font-medium text-slate-700 transition-colors duration-300 hover:text-teal-800"
        >{phone}</a>
      </li>
    )}
    <li class="flex items-center gap-x-2">
      <Icon name="email" class="size-4 shrink-0 text-teal-700" />
      <a
        href={`mailto:${email || 'm.hasanmzp@gmail.com'}`}
        class="transition-colors duration-300 hover:text-teal-800"
      >{email || 'm.hasanmzp@gmail.com'}</a>
    </li>
    {secondaryEmail && (
      <li class="flex items-center gap-x-2">
        <Icon name="email" class="size-4 shrink-0 text-slate-400" />
        <a
          href={`mailto:${secondaryEmail}`}
          class="transition-colors duration-300 hover:text-teal-800 text-xs text-slate-500"
        >{secondaryEmail}</a>
      </li>
    )}
    <li class="flex items-center gap-x-2">
      <Icon name="world" class="size-4 shrink-0 text-teal-700" />
      <a
        href="https://wellbit.in"
        class="transition-colors duration-300 hover:text-teal-800"
      >{website || 'wellbit.in'}</a>
    </li>
  </ul>
</div>
