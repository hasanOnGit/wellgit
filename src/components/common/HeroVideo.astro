---
const video =
  'https://vyclk3sx0z.ufs.sh/f/hv6ttNERWpXuOGj0KhIPk5MLw0bimBlYnq6Vd2NfSJW9gCQU';
---

{/* Hero Visual with Siri/Gemini Luminous Ambient Halo */}
<div class="relative m-auto w-full pt-6 sm:pt-12 md:pt-16 sm:w-[90%] group">
  {/* Layer 1: Ambient Gemini Diffuse Glow */}
  <div class="pointer-events-none absolute -inset-4 sm:-inset-8 rounded-3xl bg-gradient-to-tr from-cyan-400/25 via-indigo-500/20 to-fuchsia-500/20 blur-2xl sm:blur-3xl animate-gemini-glow opacity-70"></div>
  
  {/* Layer 2: Siri Edge Aura Flow */}
  <div class="pointer-events-none absolute -inset-1 sm:-inset-1.5 rounded-2xl sm:rounded-3xl bg-gradient-to-r from-cyan-400 via-blue-500 via-indigo-500 via-purple-500 to-pink-500 bg-[length:200%_auto] blur-md sm:blur-lg animate-siri-border opacity-40 group-hover:opacity-60 transition-opacity duration-500"></div>

  {/* Main Video Frame with Iridescent Glass Border */}
  <div class="relative rounded-2xl p-[1px] bg-gradient-to-r from-cyan-300/60 via-indigo-400/50 to-fuchsia-400/50 shadow-2xl shadow-slate-900/10 ring-1 ring-white/60">
    <div class="aspect-video overflow-hidden rounded-[15px] bg-slate-950">
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="/poster.png"
        class="aspect-auto rounded-xl w-full"
      >
        <source src={video} type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</div>
