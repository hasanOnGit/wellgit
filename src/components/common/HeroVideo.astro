---
const video =
  'https://vyclk3sx0z.ufs.sh/f/hv6ttNERWpXuOGj0KhIPk5MLw0bimBlYnq6Vd2NfSJW9gCQU';
---

{/* Hero Visual */}
<div class="relative m-auto w-full pt-6 sm:pt-12 md:pt-16 sm:w-[90%]">
  <div class="aspect-video overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-2xl shadow-slate-900/10 ring-1 ring-slate-900/5">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      poster="/poster.png"
      class="aspect-auto rounded-xl w-full"
    >
      <source src={video} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>
</div>
