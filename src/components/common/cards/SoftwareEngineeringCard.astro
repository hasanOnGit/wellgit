---
// Modern Enterprise Software & API Gateway Console Card
---

<div class="relative w-full rounded-2xl border border-slate-200/90 bg-white/95 p-4 sm:p-5 shadow-xl shadow-slate-900/5 ring-1 ring-slate-900/5 backdrop-blur-sm">
  {/* Window Titlebar */}
  <div class="flex items-center justify-between border-b border-slate-100 pb-3">
    <div class="flex items-center gap-2">
      <span class="size-2.5 rounded-full bg-rose-400"></span>
      <span class="size-2.5 rounded-full bg-amber-400"></span>
      <span class="size-2.5 rounded-full bg-emerald-400"></span>
      <span class="ml-2 hidden font-mono text-xs text-slate-400 sm:inline">api.wellbit.in/v1/orchestration</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 ring-1 ring-emerald-600/20">
        <span class="size-1.5 animate-pulse rounded-full bg-emerald-600"></span>
        200 OK &bull; 34ms
      </span>
    </div>
  </div>

  {/* Terminal / Code Body */}
  <div class="mt-4 rounded-xl bg-slate-950 p-4 font-mono text-xs leading-relaxed text-slate-300 shadow-inner">
    <div class="flex items-center justify-between border-b border-slate-800 pb-2 text-[11px] text-slate-400">
      <div class="flex items-center gap-2">
        <span class="rounded bg-teal-500/20 px-1.5 py-0.5 font-semibold text-teal-400">POST</span>
        <span class="text-slate-300">/api/v1/services/deploy</span>
      </div>
      <span class="text-slate-500">HTTP/2</span>
    </div>

    <div class="mt-3 space-y-1 text-[11px] sm:text-xs">
      <div><span class="text-indigo-400">"service"</span>: <span class="text-teal-300">"enterprise-core-engine"</span>,</div>
      <div><span class="text-indigo-400">"cluster"</span>: <span class="text-amber-300">"k8s-prod-us-east-1"</span>,</div>
      <div><span class="text-indigo-400">"throughput"</span>: <span class="text-emerald-400">"4,280 req/sec"</span>,</div>
      <div><span class="text-indigo-400">"security"</span>: <span class="text-sky-300">&#123; "mtls": true, "jwt": "verified" &#125;</span>,</div>
      <div><span class="text-indigo-400">"db_pool"</span>: <span class="text-emerald-400">&#123; "postgres": "active", "redis": "1.2ms" &#125;</span></div>
    </div>
  </div>

  {/* Status Footer Metrics */}
  <div class="mt-4 grid grid-cols-3 gap-2 border-t border-slate-100 pt-3 text-center">
    <div class="rounded-lg bg-slate-50 p-2">
      <div class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Uptime</div>
      <div class="font-mono text-xs sm:text-sm font-semibold text-teal-700">99.99%</div>
    </div>
    <div class="rounded-lg bg-slate-50 p-2">
      <div class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Concurrency</div>
      <div class="font-mono text-xs sm:text-sm font-semibold text-teal-700">12.5k / min</div>
    </div>
    <div class="rounded-lg bg-slate-50 p-2">
      <div class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Latency</div>
      <div class="font-mono text-xs sm:text-sm font-semibold text-teal-700">&lt;40ms</div>
    </div>
  </div>
</div>
