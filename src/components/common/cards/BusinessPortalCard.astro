---
// Enterprise Operations Portal & Workflow Dashboard Card
---

<div class="relative w-full rounded-2xl border border-slate-200/90 bg-white/95 p-4 sm:p-5 shadow-xl shadow-slate-900/5 ring-1 ring-slate-900/5 backdrop-blur-sm">
  {/* Header with Wellbit Operations Branding */}
  <div class="flex items-center justify-between border-b border-slate-100 pb-3">
    <div class="flex items-center gap-2.5">
      <img src="/logo-wellbit-symbol.png" alt="Wellbit" class="size-6 object-contain" />
      <div>
        <div class="text-xs font-semibold text-slate-900">Wellbit Operations Portal</div>
        <div class="text-[10px] text-slate-500">Enterprise CRM & Workflow Engine</div>
      </div>
    </div>
    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 ring-1 ring-emerald-600/20">
      <span class="size-1.5 animate-pulse rounded-full bg-emerald-600"></span>
      LIVE
    </span>
  </div>

  {/* Key Metrics Row */}
  <div class="mt-4 grid grid-cols-3 gap-2 text-center">
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-2.5">
      <div class="text-[10px] font-medium text-slate-500">Active Pipelines</div>
      <div class="mt-0.5 font-mono text-base font-bold text-slate-900">148</div>
      <div class="text-[9px] font-semibold text-emerald-600">+14% MoM</div>
    </div>
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-2.5">
      <div class="text-[10px] font-medium text-slate-500">Automation SLA</div>
      <div class="mt-0.5 font-mono text-base font-bold text-teal-700">99.98%</div>
      <div class="text-[9px] font-semibold text-teal-600">Deterministic</div>
    </div>
    <div class="rounded-xl border border-slate-100 bg-slate-50/80 p-2.5">
      <div class="text-[10px] font-medium text-slate-500">Tasks Handled</div>
      <div class="mt-0.5 font-mono text-base font-bold text-slate-900">42.5k</div>
      <div class="text-[9px] font-semibold text-emerald-600">Zero Backlog</div>
    </div>
  </div>

  {/* Real-Time Operational Activity */}
  <div class="mt-4 space-y-2">
    <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Live Orchestration Stream</div>

    <div class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50/60 px-3 py-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-slate-800">Invoice Audit & Extraction</span>
      </div>
      <span class="rounded bg-emerald-100/80 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-800">COMPLETED &bull; 0.8s</span>
    </div>

    <div class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50/60 px-3 py-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-teal-500 animate-pulse"></span>
        <span class="font-medium text-slate-800">HR Approval & Role Hierarchy</span>
      </div>
      <span class="rounded bg-teal-100/80 px-2 py-0.5 font-mono text-[10px] font-semibold text-teal-800">STEP 3/4</span>
    </div>

    <div class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50/60 px-3 py-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-sky-500"></span>
        <span class="font-medium text-slate-800">CRM Bi-Directional Webhook</span>
      </div>
      <span class="rounded bg-sky-100/80 px-2 py-0.5 font-mono text-[10px] font-semibold text-sky-800">SYNCED</span>
    </div>
  </div>
</div>
