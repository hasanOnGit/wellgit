---
// Autonomous AI Agent & Pipeline Card
---

<div class="relative w-full rounded-2xl border border-slate-200/90 bg-white/95 p-4 sm:p-5 shadow-xl shadow-slate-900/5 ring-1 ring-slate-900/5 backdrop-blur-sm">
  {/* Header */}
  <div class="flex items-center justify-between border-b border-slate-100 pb-3">
    <div class="flex items-center gap-2">
      <div class="flex size-7 items-center justify-center rounded-lg bg-teal-50 text-teal-600 ring-1 ring-teal-500/20">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
        </svg>
      </div>
      <div>
        <div class="text-xs font-semibold text-slate-800">Autonomous Agent Loop</div>
        <div class="text-[10px] text-slate-500">Self-Correcting Reasoning Engine</div>
      </div>
    </div>
    <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 px-2.5 py-0.5 text-[11px] font-semibold text-teal-700 ring-1 ring-teal-600/20">
      <span class="size-1.5 animate-pulse rounded-full bg-teal-600"></span>
      AGENT ACTIVE
    </span>
  </div>

  {/* Pipeline Stages */}
  <div class="mt-3.5 space-y-2.5">
    {/* Stage 1 */}
    <div class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50/70 p-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="flex size-5 items-center justify-center rounded-full bg-teal-100 text-[10px] font-bold text-teal-700">1</span>
        <span class="font-medium text-slate-700">Knowledge Retrieval (RAG)</span>
      </div>
      <span class="font-mono text-[11px] text-slate-500">pgvector &bull; 0.96 match</span>
    </div>

    {/* Stage 2 */}
    <div class="flex items-center justify-between rounded-lg border border-teal-100 bg-teal-50/30 p-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="flex size-5 items-center justify-center rounded-full bg-teal-600 text-[10px] font-bold text-white">2</span>
        <span class="font-semibold text-teal-900">Multi-Step Plan Execution</span>
      </div>
      <span class="font-mono text-[11px] text-teal-700 font-medium">3 tools invoked</span>
    </div>

    {/* Stage 3 */}
    <div class="flex items-center justify-between rounded-lg border border-slate-100 bg-slate-50/70 p-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="flex size-5 items-center justify-center rounded-full bg-emerald-100 text-[10px] font-bold text-emerald-700">3</span>
        <span class="font-medium text-slate-700">Deterministic Safety Gate</span>
      </div>
      <span class="font-mono text-[11px] font-semibold text-emerald-600">Verified &bull; 0 err</span>
    </div>
  </div>

  {/* Live Evaluation Footer */}
  <div class="mt-3.5 flex items-center justify-between rounded-xl bg-slate-900 px-3 py-2 text-slate-200">
    <div class="flex items-center gap-2">
      <svg class="size-4 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
      </svg>
      <span class="font-mono text-[11px] text-slate-300">Deterministic Output Approved</span>
    </div>
    <span class="font-mono text-[11px] text-teal-400 font-semibold">142ms</span>
  </div>
</div>
