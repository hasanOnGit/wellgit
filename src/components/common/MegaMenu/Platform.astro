---
import Icon from '@ui/icons/Icon.astro';
import { platformMenu } from '@utils/megaMenu/platform';

const sectionDescription =
  'Targeted business solutions across AI workflows, enterprise web apps, CRM, and internal systems';
const currentPath = Astro.url.pathname;
---

<div
  class="hs-dropdown [--adaptive:none] [--is-collapse:true] [--strategy:static] xl:[--is-collapse:false] xl:[--strategy:absolute] xl:[--trigger:hover]"
>
  <button
    id="mega-menu-platform"
    type="button"
    class={`hs-dropdown-toggle flex w-full items-center rounded-lg p-2 font-medium text-slate-800 hover:bg-white/80 hover:text-teal-700 transition-all duration-200 focus:outline-hidden ${
      currentPath.startsWith('/platform') || currentPath.startsWith('/solutions') ? 'text-teal-600 font-semibold underline underline-offset-4' : ''
    }`}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Mega Menu Solutions"
  >
    Solutions <Icon name="arrowDownRight" />
  </button>

  <div
    class="hs-dropdown-menu hs-dropdown-open:opacity-100 relative start-0 top-full z-10 mt-2 hidden w-full max-w-(--breakpoint-md) min-w-60 opacity-0 transition-[opacity,margin] duration-150 before:absolute before:start-0 before:-top-5 before:h-5 before:w-full xl:left-1/2 xl:-translate-x-1/2 xl:duration-300"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="mega-menu-platform"
  >
    <div
      class="bg-slate-50/95 border border-slate-200/80 rounded-xl p-3 my-1.5 shadow-xs lg:mx-8 xl:mx-6 xl:my-0 xl:rounded-lg xl:bg-white xl:bg-linear-to-t/oklch xl:from-teal-100 xl:via-transparent xl:to-white xl:px-16 xl:py-10 xl:shadow-lg xl:ring-1 xl:ring-slate-200 xl:border-none"
    >
      <p class="text-xs sm:text-sm text-slate-500 xl:text-slate-600 mb-2 xl:mb-0">
        {sectionDescription}
      </p>
      <hr class="my-2.5 xl:mb-5 border-slate-200" />

      <div class="gap-4 py-1 md:grid md:grid-cols-2 md:p-2">
        {
          platformMenu.map(item => (
            <a
              class="group flex gap-x-4 rounded-lg p-3 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden transition"
              href={item.href}
            >
              <div class="size-9 rounded-lg bg-teal-50 flex items-center justify-center text-teal-600 shrink-0 group-hover:bg-teal-600 group-hover:text-white transition">
                <Icon
                  name={item.icon}
                  class="size-5 shrink-0"
                />
              </div>

              <div class="grow">
                <p class="text-sm font-medium text-slate-800 group-hover:text-teal-700 transition">
                  {item.title}
                </p>
                <p class="text-sm text-slate-500">{item.description}</p>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs">
        <span class="text-slate-500 font-medium">Bespoke software engineered for long-term scalability</span>
        <a
          href="/solutions"
          class="inline-flex items-center gap-1 font-semibold text-teal-600 hover:text-teal-700 transition"
        >
          View All Solutions
          <Icon name="chevronRight" class="size-3.5" />
        </a>
      </div>
    </div>
  </div>
</div>
