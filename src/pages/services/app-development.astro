---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import type { WithContext, Thing } from 'schema-dts';

const seo = {
  title: 'Mobile & Web App Development (iOS, Android, React Native) | Wellbit Technologies',
  description:
    'Wellbit Technologies engineers high-performance mobile apps for iOS and Android, cross-platform apps in React Native and Flutter, and enterprise SaaS web platforms with offline sync.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Mobile & Web App Development',
  serviceType: 'Mobile Application Engineering',
  provider: {
    '@type': 'Organization',
    name: 'Wellbit Technologies',
    url: 'https://wellbit.in',
  },
  description:
    'Native iOS & Android, React Native, Flutter, and progressive web application development engineered for fluid performance and scale.',
  areaServed: 'Worldwide',
};

const appDisciplines = [
  {
    title: 'Cross-Platform Mobile Apps (React Native & Flutter)',
    description: 'Build native-performing iOS and Android apps from a single, robust codebase. Enjoy 60fps animations, native module bridges, and half the development and maintenance overhead.',
    techs: ['React Native', 'Flutter', 'TypeScript', 'Dart', 'Expo', 'Native Bridges'],
    stat: '60 FPS',
    statLabel: 'Fluid Performance',
  },
  {
    title: 'Native iOS & Android Engineering',
    description: 'When maximum device hardware access and platform-specific UI polish are required, we build native applications utilizing modern Swift/SwiftUI and Kotlin/Jetpack Compose.',
    techs: ['Swift', 'SwiftUI', 'Kotlin', 'Jetpack Compose', 'CoreData', 'Room DB'],
    stat: '100% Native',
    statLabel: 'Hardware Acceleration',
  },
  {
    title: 'Progressive Web Apps (PWA) & B2B SaaS',
    description: 'Responsive, app-like web experiences built with React 19, Next.js, and modern service workers that install directly on devices and work seamlessly on flaky network connections.',
    techs: ['Next.js', 'React 19', 'Astro SSR', 'Service Workers', 'IndexedDB', 'WebSockets'],
    stat: '< 0.5s',
    statLabel: 'LCP First Load',
  },
  {
    title: 'Offline-First Sync & Embedded Storage',
    description: 'Enable users to create, edit, and navigate data offline with local SQLite/WatermelonDB persistence that automatically syncs and resolves conflicts once connectivity returns.',
    techs: ['SQLite', 'WatermelonDB', 'Conflict Resolution', 'Background Workers', 'Delta Sync'],
    stat: 'Zero Data Loss',
    statLabel: 'Offline Resiliency',
  },
];

const mobileFeatures = [
  {
    title: 'Biometrics & Security',
    desc: 'FaceID, TouchID, encrypted Keychain/Keystore token storage, and OWASP mobile security standards.',
  },
  {
    title: 'Push Notifications',
    desc: 'Automated segmented messaging with Apple Push Notification Service (APNs) and Firebase Cloud Messaging (FCM).',
  },
  {
    title: 'Payment Gateways',
    desc: 'Integrated Apple Pay, Google Pay, Stripe SDKs, Razorpay, and compliant in-app subscription billing.',
  },
  {
    title: 'Hardware & Sensors',
    desc: 'Bluetooth Low Energy (BLE), background GPS geofencing, QR/Barcode scanning, and camera media pipelines.',
  },
];
---

<BaseLayout seo={seo} schema={schema}>
  {/* Hero Section */}
  <section class="relative overflow-hidden bg-hero-gradient pt-28 sm:pt-40 lg:pt-44 pb-16 sm:pb-24 border-b border-slate-200">
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-blue-200/40 blur-3xl animate-pulse-glow"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb */}
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-mono">
        <a href="/" class="hover:text-teal-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-400">Services</span>
        <span>/</span>
        <span class="text-teal-700 font-semibold">Mobile & Web App Development</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 text-left">
          <div class="inline-flex items-center gap-x-2 rounded-full border border-teal-200 bg-teal-50 px-3.5 py-1 text-xs font-semibold text-teal-800 shadow-2xs mb-5">
            <span class="size-2 rounded-full bg-teal-500 animate-ping"></span>
            Mobile & Full-Stack App Engineering
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl font-display leading-[1.1]">
            Fluid, High-Performance <span class="bg-clip-text text-transparent bg-gradient-to-r from-teal-600 via-blue-600 to-indigo-600">Mobile & Web Applications</span>
          </h1>

          <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
            We design, develop, and launch high-impact mobile applications for iOS & Android alongside responsive web SaaS platforms. From initial UX prototyping to App Store & Google Play publishing, we build apps users love.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-teal-400 via-blue-500 to-cyan-400 animate-pulse-glow shadow-xl shadow-teal-500/20 hover:shadow-teal-500/40 transition-all duration-300">
              <Button href="/contact" variant="primary" className="w-full sm:w-auto px-8 py-3.5 text-sm sm:text-base font-bold shadow-none">
                Discuss Your App Concept
                <svg class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </Button>
            </div>
            <Button href="/downloads/request-quote" variant="secondary" className="w-full sm:w-auto px-7 py-3.5 text-sm sm:text-base font-semibold">
              Get App Quote & Timeline
            </Button>
          </div>
        </div>

        {/* Hero Interactive Phone UI SVG Frame */}
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-72 sm:w-80 rounded-[2.5rem] border-4 border-slate-900 bg-slate-950 p-3 shadow-2xl shadow-slate-950/20 ring-1 ring-slate-800">
            {/* Notch */}
            <div class="absolute top-4 left-1/2 -translate-x-1/2 h-4 w-28 rounded-full bg-slate-900 flex items-center justify-center">
              <div class="size-2 rounded-full bg-slate-800"></div>
            </div>

            {/* Screen Content */}
            <div class="rounded-[2rem] bg-white p-4 pt-7 overflow-hidden text-slate-800 text-left">
              {/* Top App Header */}
              <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <div class="size-7 rounded-lg bg-teal-600 flex items-center justify-center text-white text-xs font-bold">W</div>
                  <span class="text-xs font-bold text-slate-900">Wellbit App Portal</span>
                </div>
                <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
              </div>

              {/* Dynamic Chart / Card */}
              <div class="my-3 rounded-xl bg-gradient-to-br from-teal-50 to-blue-50/70 p-3.5 border border-teal-100/80">
                <div class="text-[10px] text-teal-800 font-semibold">Real-Time Concurrency</div>
                <div class="text-xl font-extrabold text-slate-900 font-mono mt-0.5">24,590 <span class="text-xs text-teal-600 font-normal">users</span></div>
                {/* Micro Chart SVG */}
                <svg class="w-full h-10 mt-1" viewBox="0 0 100 30" fill="none">
                  <path d="M0 25 Q20 5 40 18 T80 8 T100 15" stroke="#14b8a6" stroke-width="2.5" fill="none" />
                  <circle cx="80" cy="8" r="3" fill="#14b8a6" class="animate-ping" />
                </svg>
              </div>

              {/* Action Buttons Mock */}
              <div class="space-y-2 mb-3">
                <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 border border-slate-100 text-xs">
                  <span class="font-medium text-slate-700">Offline SQLite Cache</span>
                  <span class="text-[10px] text-emerald-700 font-bold bg-emerald-50 px-1.5 py-0.5 rounded">SYNCED</span>
                </div>
                <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 border border-slate-100 text-xs">
                  <span class="font-medium text-slate-700">Biometric Auth</span>
                  <span class="text-[10px] text-teal-700 font-bold bg-teal-50 px-1.5 py-0.5 rounded">VERIFIED</span>
                </div>
              </div>

              {/* Primary Action Button */}
              <div class="rounded-xl bg-btn-gradient text-white py-2 text-center text-xs font-semibold shadow-xs">
                Launch Enterprise Pipeline
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* App Engineering Disciplines */}
  <section class="py-16 sm:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl font-display">
          Full-Stack App Engineering Across Every Platform
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          Whether you need a unified cross-platform application for both app stores or a dedicated high-performance native build, we engineer for buttery-smooth responsiveness.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          appDisciplines.map((item, idx) => (
            <div class="group relative rounded-2xl border border-slate-200 bg-gradient-to-br from-white to-slate-50/60 p-7 sm:p-8 shadow-xs hover:border-teal-400 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs font-semibold text-teal-700 bg-teal-50 border border-teal-200/60 rounded px-2.5 py-1">
                    APP_DOMAIN_0{idx + 1}
                  </span>
                  <div class="text-right">
                    <span class="block text-lg font-bold text-slate-900 font-mono">{item.stat}</span>
                    <span class="block text-[11px] text-slate-500 font-medium">{item.statLabel}</span>
                  </div>
                </div>

                <h3 class="text-xl font-bold text-slate-900 font-display group-hover:text-teal-700 transition-colors">
                  {item.title}
                </h3>

                <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                  {item.description}
                </p>

                <div class="mt-5 flex flex-wrap gap-1.5">
                  {item.techs.map(t => (
                    <span class="inline-flex items-center rounded-md bg-white border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-teal-700">
                <span>Production Mobile Standards</span>
                <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Built-in Features Grid */}
  <section class="py-16 bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-display">
          Core Capabilities Built into Every App
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600">
          We integrate enterprise-grade security, background task execution, and seamless payment flows from day one.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          mobileFeatures.map(feat => (
            <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs hover:border-teal-400 transition-colors">
              <h4 class="font-bold text-slate-900 text-sm">{feat.title}</h4>
              <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">{feat.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* App Store Publishing Guarantee */}
  <section class="py-16 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl bg-gradient-to-r from-teal-50 via-slate-50 to-blue-50 border border-teal-200/80 p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-mono font-bold text-teal-800 bg-teal-100/80 px-2.5 py-1 rounded">APP STORE APPROVAL GUARANTEE</span>
          <h3 class="text-2xl font-bold text-slate-900 font-display mt-2">End-to-End Store Publishing & Code Ownership</h3>
          <p class="text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed">
            We handle Apple App Store and Google Play Store submission guidelines, privacy policies, screenshot generation, TestFlight beta distribution, and handover of signing keys.
          </p>
        </div>
        <Button href="/contact" variant="primary" className="shrink-0 px-6 py-3 text-sm font-semibold whitespace-nowrap">
          Schedule App Briefing
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
