---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import type { WithContext, Thing } from 'schema-dts';

const seo = {
  title: 'Cloud Infrastructure, Kubernetes & DevOps Engineering | Wellbit Technologies',
  description:
    'Wellbit Technologies delivers enterprise cloud engineering: AWS and GCP deployments, Kubernetes orchestration, Terraform Infrastructure as Code, CI/CD pipelines, and 99.99% SRE reliability.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Cloud Infrastructure & DevOps Engineering',
  serviceType: 'Cloud Architecture & SRE',
  provider: {
    '@type': 'Organization',
    name: 'Wellbit Technologies',
    url: 'https://wellbit.in',
  },
  description:
    'Cloud-native architecture, Kubernetes clustering, Terraform infrastructure automation, and continuous delivery pipelines engineered for 99.99% uptime.',
  areaServed: 'Worldwide',
};

const cloudPillars = [
  {
    title: 'Kubernetes & Container Orchestration',
    description: 'Deploy, scale, and manage containerized workloads on AWS EKS, Google GKE, or self-hosted clusters with Helm, automated horizontal pod auto-scaling, and zero-downtime rolling updates.',
    techs: ['Kubernetes (K8s)', 'Docker', 'AWS EKS', 'Google GKE', 'Helm', 'Ingress NGINX'],
    kpi: '99.99%',
    kpiLabel: 'Target SLA Uptime',
  },
  {
    title: 'Infrastructure as Code (Terraform & IaC)',
    description: 'Eliminate manual console misconfigurations. We codify VPCs, subnets, IAM policies, serverless functions, and storage buckets into version-controlled, auditable Terraform and Pulumi stacks.',
    techs: ['Terraform', 'Pulumi', 'AWS CloudFormation', 'Terragrunt', 'State Locking', 'GitOps'],
    kpi: '100% Codified',
    kpiLabel: 'Reproducible Infra',
  },
  {
    title: 'Zero-Downtime CI/CD Automated Pipelines',
    description: 'Accelerate release velocity with robust GitHub Actions pipelines that run automated test harnesses, build minimal hardened container images, and execute blue-green or canary rollouts.',
    techs: ['GitHub Actions', 'ArgoCD', 'Docker Multi-Stage', 'Canary Rollouts', 'Smoke Testing'],
    kpi: '< 6 mins',
    kpiLabel: 'Build-to-Prod Cycle',
  },
  {
    title: 'SRE Observability, Telemetry & Security',
    description: 'Gain real-time visibility across application health and distributed microservices with Prometheus metrics, Grafana dashboards, OpenTelemetry distributed tracing, and automated alert routing.',
    techs: ['OpenTelemetry', 'Prometheus', 'Grafana', 'Datadog', 'Sentry', 'PagerDuty Alerts'],
    kpi: '< 15 mins',
    kpiLabel: 'Mean Time to Recovery',
  },
];
---

<BaseLayout seo={seo} schema={schema}>
  {/* Hero Section */}
  <section class="relative overflow-hidden bg-hero-gradient pt-28 sm:pt-40 lg:pt-44 pb-16 sm:pb-24 border-b border-slate-200">
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-indigo-200/40 blur-3xl animate-pulse-glow"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb */}
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-mono">
        <a href="/" class="hover:text-teal-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-400">Services</span>
        <span>/</span>
        <span class="text-teal-700 font-semibold">Cloud Infrastructure & DevOps</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 text-left">
          <div class="inline-flex items-center gap-x-2 rounded-full border border-teal-200 bg-teal-50 px-3.5 py-1 text-xs font-semibold text-teal-800 shadow-2xs mb-5">
            <span class="size-2 rounded-full bg-teal-500 animate-ping"></span>
            Cloud Architecture & SRE Reliability
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl font-display leading-[1.1]">
            Resilient Cloud Infrastructure, <span class="bg-clip-text text-transparent bg-gradient-to-r from-teal-600 via-blue-600 to-indigo-600">Kubernetes & Zero-Downtime DevOps</span>
          </h1>

          <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
            We architect, deploy, and manage secure multi-cloud environments across AWS, Google Cloud, and Cloudflare. From container orchestration with Kubernetes to automated CI/CD delivery pipelines, we ensure your platforms stay rock-solid.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-teal-400 via-blue-500 to-cyan-400 animate-pulse-glow shadow-xl shadow-teal-500/20 hover:shadow-teal-500/40 transition-all duration-300">
              <Button href="/contact" variant="primary" className="w-full sm:w-auto px-8 py-3.5 text-sm sm:text-base font-bold shadow-none">
                Consult with Cloud Architects
                <svg class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </Button>
            </div>
            <Button href="/downloads/core-capabilities" variant="secondary" className="w-full sm:w-auto px-7 py-3.5 text-sm sm:text-base font-semibold">
              View Architectural Specs
            </Button>
          </div>
        </div>

        {/* Hero Cloud Infrastructure Cluster SVG Diagram */}
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-slate-200/90 bg-white/95 p-5 sm:p-6 shadow-xl shadow-slate-900/5 ring-1 ring-slate-900/5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4 text-xs font-mono">
              <span class="flex items-center gap-1.5 text-slate-700 font-bold">
                <span class="size-2 rounded-full bg-teal-500 animate-pulse"></span>
                K8S_MULTI_REGION_CLUSTER
              </span>
              <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded">99.99% UPTIME</span>
            </div>

            {/* Cloud Cluster SVG */}
            <svg class="w-full h-64 text-slate-700" viewBox="0 0 360 220" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Cloudflare Edge */}
              <rect x="20" y="10" width="320" height="35" rx="6" class="fill-slate-900 text-white" />
              <text x="180" y="32" text-anchor="middle" class="fill-teal-400 text-[10px] font-bold font-mono">CLOUDFLARE EDGE &bull; DDoS &amp; SSL TERMINATION</text>

              {/* Ingress Router */}
              <rect x="120" y="65" width="120" height="30" rx="4" class="fill-teal-50 stroke-teal-500" stroke-width="1.2" />
              <text x="180" y="84" text-anchor="middle" class="fill-teal-900 text-[9px] font-bold font-mono">INGRESS CONTROLLER</text>
              <path d="M180 45 L180 65" stroke="#0d9488" stroke-width="1.5" />
              <path d="M180 95 L180 115" stroke="#0d9488" stroke-width="1.5" />

              {/* K8s Pods Group */}
              <rect x="20" y="115" width="320" height="55" rx="6" class="fill-slate-50 stroke-slate-300" stroke-width="1.2" stroke-dasharray="3 3" />
              <text x="30" y="128" class="fill-slate-500 text-[8px] font-mono">AUTO-SCALING WORKER NODES (EKS/GKE)</text>

              {/* Pod 1 */}
              <rect x="35" y="135" width="80" height="26" rx="4" class="fill-white stroke-teal-500" stroke-width="1.2" />
              <text x="47" y="152" class="fill-slate-800 text-[8px] font-mono font-bold">POD 1: APP</text>
              <circle cx="101" cy="148" r="3" fill="#14b8a6" class="animate-ping" />

              {/* Pod 2 */}
              <rect x="140" y="135" width="80" height="26" rx="4" class="fill-white stroke-teal-500" stroke-width="1.2" />
              <text x="152" y="152" class="fill-slate-800 text-[8px] font-mono font-bold">POD 2: APP</text>
              <circle cx="206" cy="148" r="3" fill="#14b8a6" class="animate-ping" />

              {/* Pod 3 */}
              <rect x="245" y="135" width="80" height="26" rx="4" class="fill-white stroke-blue-500" stroke-width="1.2" />
              <text x="257" y="152" class="fill-slate-800 text-[8px] font-mono font-bold">POD 3: CACHE</text>
              <circle cx="311" cy="148" r="3" fill="#3b82f6" class="animate-ping" />

              {/* Database Layer */}
              <rect x="90" y="185" width="180" height="28" rx="4" class="fill-teal-50 stroke-teal-600" stroke-width="1.2" />
              <text x="180" y="203" text-anchor="middle" class="fill-teal-900 text-[9px] font-bold font-mono">POSTGRESQL MULTI-AZ REPLICA</text>
              <path d="M180 170 L180 185" stroke="#0d9488" stroke-width="1.2" />
            </svg>

            <div class="mt-2 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
              <span>Terraform State: Automated Drift Sync</span>
              <span class="font-mono text-teal-700 font-bold">Zero Lock-in</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Cloud Disciplines Grid */}
  <section class="py-16 sm:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl font-display">
          Enterprise Cloud Disciplines Designed for Production Stability
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          From single-command Terraform provisioning to continuous automated canary deployments, we ensure your infrastructure runs flawlessly.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          cloudPillars.map((item, idx) => (
            <div class="group relative rounded-2xl border border-slate-200 bg-gradient-to-br from-white to-slate-50/60 p-7 sm:p-8 shadow-xs hover:border-teal-400 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs font-semibold text-teal-700 bg-teal-50 border border-teal-200/60 rounded px-2.5 py-1">
                    CLOUD_DOMAIN_0{idx + 1}
                  </span>
                  <div class="text-right">
                    <span class="block text-lg font-bold text-slate-900 font-mono">{item.kpi}</span>
                    <span class="block text-[11px] text-slate-500 font-medium">{item.kpiLabel}</span>
                  </div>
                </div>

                <h3 class="text-xl font-bold text-slate-900 font-display group-hover:text-teal-700 transition-colors">
                  {item.title}
                </h3>

                <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                  {item.description}
                </p>

                <div class="mt-5 flex flex-wrap gap-1.5">
                  {item.techs.map(t => (
                    <span class="inline-flex items-center rounded-md bg-white border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-teal-700">
                <span>Hardened SRE Runbooks</span>
                <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* High-Impact CTA */}
  <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-navy via-slate-900 to-navy p-8 sm:p-14 text-white shadow-2xl border border-slate-800">
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display">
          Ready to Modernize Your Cloud & DevOps Architecture?
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Book an infrastructure audit with our certified cloud architects. We review your current hosting setup, identify security and cost leaks, and build your deployment roadmap.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-teal-400 via-blue-500 to-cyan-400 animate-pulse-glow shadow-xl shadow-teal-500/25">
            <Button href="/contact" variant="primary" className="px-8 py-3.5 text-base font-bold shadow-none">
              Request Cloud Infrastructure Audit
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
