---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import type { WithContext, Thing } from 'schema-dts';

const seo = {
  title: 'Custom Software Development & Enterprise Engineering | Wellbit Technologies',
  description:
    'Wellbit Technologies builds resilient enterprise software, distributed backend systems, event-driven microservices, and high-concurrency APIs tailored for long-term scalability and zero lock-in.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Custom Software Engineering',
  serviceType: 'Enterprise Software Engineering',
  provider: {
    '@type': 'Organization',
    name: 'Wellbit Technologies',
    url: 'https://wellbit.in',
  },
  description:
    'Custom software development, distributed microservices, and enterprise API architectures engineered for high concurrency and 99.99% availability.',
  areaServed: 'Worldwide',
};

const corePillars = [
  {
    title: 'Distributed Microservices & Event Streams',
    description: 'Deconstruct complex business logic into decoupled, fault-tolerant services communicating via high-throughput Kafka and RabbitMQ streams with circuit breakers and fallback pipelines.',
    tags: ['Go', 'Node.js', 'FastAPI', 'Apache Kafka', 'gRPC', 'RabbitMQ'],
    metric: '100k+ ops/sec',
    metricLabel: 'Event Throughput',
  },
  {
    title: 'High-Throughput APIs & Integration Fabrics',
    description: 'Design and deploy type-safe REST, GraphQL, and high-performance gRPC interfaces with strict OpenAPI 3.1 contracts, zero-trust token authentication, and distributed rate limiting.',
    tags: ['TypeScript', 'GraphQL', 'tRPC', 'REST APIs', 'OAuth 2.0', 'Redis Caching'],
    metric: '< 110ms',
    metricLabel: 'p99 Response Latency',
  },
  {
    title: 'Resilient Persistence & Data Modeling',
    description: 'Architect structured relational databases and document stores with connection pooling, multi-tenant partitioning, read-replicas, and ACID transactional guarantees.',
    tags: ['PostgreSQL', 'MongoDB Atlas', 'ClickHouse', 'Redis Cluster', 'Prisma / Drizzle'],
    metric: '99.99%',
    metricLabel: 'Transactional Durability',
  },
  {
    title: 'Monolith Refactoring & System Modernization',
    description: 'Safely migrate fragile legacy codebases using the strangler fig pattern, incremental micro-frontends, and automated regression test harnesses without operational downtime.',
    tags: ['Domain-Driven Design', 'Strangler Fig', 'Docker', 'CI/CD Pipelines', 'Zero Downtime'],
    metric: '0 downtime',
    metricLabel: 'Migration Guarantee',
  },
];
---

<BaseLayout seo={seo} schema={schema}>
  {/* Hero Section */}
  <section class="relative overflow-hidden bg-hero-gradient pt-28 sm:pt-40 lg:pt-44 pb-16 sm:pb-24 border-b border-slate-200">
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-teal-200/40 blur-3xl animate-pulse-glow"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb */}
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-mono">
        <a href="/" class="hover:text-teal-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-400">Services</span>
        <span>/</span>
        <span class="text-teal-700 font-semibold">Custom Software Development</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 text-left">
          <div class="inline-flex items-center gap-x-2 rounded-full border border-teal-200 bg-teal-50 px-3.5 py-1 text-xs font-semibold text-teal-800 shadow-2xs mb-5">
            <span class="size-2 rounded-full bg-teal-500 animate-ping"></span>
            Enterprise Software Architecture
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl font-display leading-[1.1]">
            Bespoke Software Systems Built for <span class="bg-clip-text text-transparent bg-gradient-to-r from-teal-600 via-blue-600 to-indigo-600">Scale, Concurrency & Longevity</span>
          </h1>

          <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
            We engineer mission-critical backend platforms, distributed microservices, and modern API architectures tailored to your exact workflows—built with strict type-safety, complete code ownership, and zero vendor lock-in.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-teal-400 via-blue-500 to-cyan-400 animate-pulse-glow shadow-xl shadow-teal-500/20 hover:shadow-teal-500/40 transition-all duration-300">
              <Button href="/contact" variant="primary" className="w-full sm:w-auto px-8 py-3.5 text-sm sm:text-base font-bold shadow-none">
                Schedule Architecture Consultation
                <svg class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </Button>
            </div>
            <Button href="/downloads/request-quote" variant="secondary" className="w-full sm:w-auto px-7 py-3.5 text-sm sm:text-base font-semibold">
              Request Project Estimate
            </Button>
          </div>
        </div>

        {/* Hero SVG Interactive Architecture Diagram */}
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-slate-200/90 bg-white/95 p-5 sm:p-6 shadow-xl shadow-slate-900/5 ring-1 ring-slate-900/5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4 text-xs font-mono">
              <span class="flex items-center gap-1.5 text-slate-600 font-semibold">
                <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                DISTRIBUTED_PIPELINE.SYS
              </span>
              <span class="text-teal-700 font-bold bg-teal-50 px-2 py-0.5 rounded">ACID COMPLIANT</span>
            </div>

            {/* Microservices SVG Diagram */}
            <svg class="w-full h-64 text-slate-700" viewBox="0 0 360 220" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Client Layer */}
              <rect x="15" y="20" width="80" height="35" rx="6" class="fill-slate-50 stroke-slate-300" stroke-width="1.2" />
              <text x="32" y="42" class="fill-slate-700 text-[10px] font-bold font-mono">CLIENT APPS</text>

              {/* Edge Gateway */}
              <rect x="135" y="15" width="90" height="45" rx="6" class="fill-teal-50 stroke-teal-500" stroke-width="1.5" />
              <text x="145" y="36" class="fill-teal-900 text-[9px] font-bold font-mono">API GATEWAY</text>
              <text x="145" y="48" class="fill-teal-600 text-[8px] font-mono">Rate-Limit & Auth</text>

              {/* Arrow 1 */}
              <path d="M95 38 L135 38" stroke="#0d9488" stroke-width="1.5" stroke-dasharray="3 3" />

              {/* Message Broker Kafka */}
              <rect x="75" y="90" width="210" height="34" rx="6" class="fill-slate-900 text-white" />
              <text x="110" y="111" class="fill-teal-400 text-[10px] font-bold font-mono">APACHE KAFKA EVENT STREAM</text>

              {/* Connection down */}
              <path d="M180 60 L180 90" stroke="#0d9488" stroke-width="1.5" />

              {/* Microservice Worker 1 */}
              <rect x="15" y="150" width="95" height="50" rx="6" class="fill-white stroke-slate-300" stroke-width="1.2" />
              <text x="25" y="172" class="fill-slate-800 text-[9px] font-bold font-mono">ORDER SVC (Go)</text>
              <text x="25" y="186" class="fill-slate-500 text-[8px] font-mono">&bull; Event Handler</text>

              {/* Microservice Worker 2 */}
              <rect x="130" y="150" width="100" height="50" rx="6" class="fill-white stroke-slate-300" stroke-width="1.2" />
              <text x="140" y="172" class="fill-slate-800 text-[9px] font-bold font-mono">BILLING (Node)</text>
              <text x="140" y="186" class="fill-slate-500 text-[8px] font-mono">&bull; Stripe / Ledger</text>

              {/* Microservice Worker 3 */}
              <rect x="250" y="150" width="95" height="50" rx="6" class="fill-teal-50 stroke-teal-500" stroke-width="1.2" />
              <text x="260" y="172" class="fill-teal-900 text-[9px] font-bold font-mono">TELEMETRY (Py)</text>
              <text x="260" y="186" class="fill-teal-600 text-[8px] font-mono">&bull; Vector / Logs</text>

              {/* Connections Kafka to Workers */}
              <path d="M62 124 L62 150 M180 124 L180 150 M298 124 L298 150" stroke="#0d9488" stroke-width="1.2" stroke-dasharray="2 2" />
              <circle cx="62" cy="135" r="2.5" fill="#14b8a6" class="animate-ping" />
              <circle cx="180" cy="135" r="2.5" fill="#14b8a6" class="animate-ping" />
            </svg>

            <div class="mt-2 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
              <span>Failover Strategy: Self-Healing</span>
              <span class="font-mono text-teal-700 font-bold">Zero Data Loss</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Core Engineering Disciplines */}
  <section class="py-16 sm:py-24 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-14">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl font-display">
          Engineered for Heavy Loads, Zero Leaks & Extreme Durability
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          We build backends that stay fast and predictable during traffic surges, complex multi-step transactions, and data growth.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          corePillars.map((pillar, idx) => (
            <div class="group relative rounded-2xl border border-slate-200 bg-gradient-to-br from-white to-slate-50/60 p-7 sm:p-8 shadow-xs hover:border-teal-400 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs font-semibold text-teal-700 bg-teal-50 border border-teal-200/60 rounded px-2.5 py-1">
                    ENGINEERING_DOMAIN_0{idx + 1}
                  </span>
                  <div class="text-right">
                    <span class="block text-lg font-bold text-slate-900 font-mono">{pillar.metric}</span>
                    <span class="block text-[11px] text-slate-500 font-medium">{pillar.metricLabel}</span>
                  </div>
                </div>

                <h3 class="text-xl font-bold text-slate-900 font-display group-hover:text-teal-700 transition-colors">
                  {pillar.title}
                </h3>

                <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                  {pillar.description}
                </p>

                <div class="mt-5 flex flex-wrap gap-1.5">
                  {pillar.tags.map(t => (
                    <span class="inline-flex items-center rounded-md bg-white border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-teal-700">
                <span>Enterprise Production Grade</span>
                <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Client Deliverables & Standards */}
  <section class="py-16 bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-display">
          What Every Wellbit Software Engagement Delivers
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600">
          We deliver complete production assets—not black boxes or developer-locked systems.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center font-bold mb-3">01</div>
          <h4 class="font-bold text-slate-900 text-sm">Full Source Repository</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">100% intellectual property ownership in your private GitHub or GitLab instance.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center font-bold mb-3">02</div>
          <h4 class="font-bold text-slate-900 text-sm">OpenAPI & Swagger Specs</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">Exhaustive interactive API documentation with request/response schema validation.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center font-bold mb-3">03</div>
          <h4 class="font-bold text-slate-900 text-sm">Automated Test Suites</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">Unit, integration, and load test harnesses baked into CI/CD deployment pipelines.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center font-bold mb-3">04</div>
          <h4 class="font-bold text-slate-900 text-sm">Containerized Runbooks</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">Docker compose and Kubernetes manifests for one-command local dev and cloud builds.</p>
        </div>
      </div>
    </div>
  </section>

  {/* High-Impact CTA */}
  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-navy via-slate-900 to-navy p-8 sm:p-14 text-white shadow-2xl border border-slate-800">
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display">
          Ready to Build Your Next Custom Software Platform?
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Talk directly with our senior software architects. We review your requirements, suggest optimal tech stacks, and prepare an actionable scope.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-teal-400 via-blue-500 to-cyan-400 animate-pulse-glow shadow-xl shadow-teal-500/25">
            <Button href="/contact" variant="primary" className="px-8 py-3.5 text-base font-bold shadow-none">
              Start Project Conversation
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            </Button>
          </div>
          <a href="tel:+918948626497" class="text-sm font-semibold text-teal-300 hover:text-white transition-colors flex items-center gap-2">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Direct Call: +91 8948626497
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
