---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import type { WithContext, Thing } from 'schema-dts';

const seo = {
  title: 'Enterprise SAP Solutions, S/4HANA & BTP Integration | Wellbit Technologies',
  description:
    'Wellbit Technologies delivers end-to-end enterprise SAP solutions: S/4HANA cloud migrations, SAP BTP integration suite, modern Fiori/UI5 applications, Clean Core ABAP development, and 24/7 AMS support.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Enterprise SAP Solutions & S/4HANA Transformation',
  serviceType: 'Enterprise ERP Architecture & SAP Consulting',
  provider: {
    '@type': 'Organization',
    name: 'Wellbit Technologies',
    url: 'https://wellbit.in',
  },
  description:
    'Full-lifecycle enterprise SAP solutions: S/4HANA cloud transitions, SAP BTP integration, custom Fiori user experiences, and Clean Core development engineered for high reliability.',
  areaServed: 'Worldwide',
};

const sapPillars = [
  {
    title: 'SAP S/4HANA Migration & Cloud Transition',
    description:
      'Seamlessly transition from legacy ECC 6.0 to SAP S/4HANA Cloud or On-Premise using Greenfield, Brownfield, or Selective Data Transition strategies with zero disruption to daily business operations.',
    tags: ['SAP S/4HANA', 'ECC 6.0 Migration', 'Clean Core', 'Migration Cockpit', 'HANA DB', 'SLT Pipeline'],
    metric: 'Zero Downtime',
    metricLabel: 'Cutover Methodology',
  },
  {
    title: 'SAP BTP & Hybrid Cloud Integrations (CPI)',
    description:
      'Connect your SAP digital core to modern microservices, Salesforce, payment gateways, and third-party SaaS using SAP Business Technology Platform (BTP), Cloud Integration (CPI), Event Mesh, and OData APIs.',
    tags: ['SAP BTP', 'Integration Suite (CPI)', 'Cloud Connector', 'Event Mesh', 'OData APIs', 'Salesforce Sync'],
    metric: '< 180ms',
    metricLabel: 'p99 Sync Latency',
  },
  {
    title: 'Modern SAP Fiori & Custom UI5 Web Experiences',
    description:
      'Transform complex legacy SAP GUI transaction screens into intuitive, modern, role-based SAP Fiori and SAPUI5 applications designed for desktop, tablet, and mobile with fluid responsiveness.',
    tags: ['SAP Fiori', 'SAPUI5', 'Fiori Elements', 'SAP Launchpad', 'Responsive UX', 'Role-Based Access'],
    metric: '100% Mobile',
    metricLabel: 'Cross-Device Access',
  },
  {
    title: 'Clean Core ABAP & RAP (RESTful Programming)',
    description:
      'Architect cloud-ready custom business logic adhering to SAP Clean Core standards. We build high-throughput Core Data Services (CDS), AMDP, and OData V4 services using the modern ABAP RESTful Application Programming model.',
    tags: ['ABAP Cloud', 'RAP Model', 'Core Data Services (CDS)', 'AMDP', 'OData V4', 'Clean Core'],
    metric: '100% Decoupled',
    metricLabel: 'Upgrade-Ready Core',
  },
];
---

<BaseLayout seo={seo} schema={schema}>
  {/* Hero Section */}
  <section class="relative overflow-hidden bg-hero-gradient pt-28 sm:pt-40 lg:pt-44 pb-16 sm:pb-24 border-b border-slate-200">
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-amber-200/40 blur-3xl animate-pulse-glow"></div>
    <div class="pointer-events-none absolute bottom-0 right-10 -z-10 h-80 w-80 rounded-full bg-teal-200/30 blur-3xl animate-float"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb */}
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-mono">
        <a href="/" class="hover:text-teal-700 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-400">Services</span>
        <span>/</span>
        <span class="text-teal-700 font-semibold">Enterprise SAP Solutions</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 text-left">
          <div class="inline-flex items-center gap-x-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1 text-xs font-semibold text-amber-800 shadow-2xs mb-5">
            <span class="size-2 rounded-full bg-amber-500 animate-ping"></span>
            Enterprise Digital Core &amp; ERP
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl font-display leading-[1.1]">
            Modernize Your Enterprise Digital Core with <span class="bg-clip-text text-transparent bg-gradient-to-r from-amber-600 via-teal-600 to-blue-600">Clean, Scalable SAP Engineering</span>
          </h1>

          <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
            We help ambitious enterprises build agile, cloud-ready ERP foundations—delivering end-to-end SAP S/4HANA transitions, SAP BTP integrations, custom Fiori apps, and Clean Core ABAP development with zero operational downtime.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-amber-400 via-teal-500 to-blue-500 animate-pulse-glow shadow-xl shadow-amber-500/20 hover:shadow-teal-500/40 transition-all duration-300">
              <Button href="/contact" variant="primary" className="w-full sm:w-auto px-8 py-3.5 text-sm sm:text-base font-bold shadow-none">
                Schedule SAP Consultation
                <svg class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </Button>
            </div>
            <Button href="/downloads/request-quote" variant="secondary" className="w-full sm:w-auto px-7 py-3.5 text-sm sm:text-base font-semibold">
              Request Project Estimate
            </Button>
          </div>
        </div>

        {/* Hero SVG Interactive SAP Architecture Diagram */}
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-slate-200/90 bg-white/95 p-5 sm:p-6 shadow-xl shadow-slate-900/5 ring-1 ring-slate-900/5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4 text-xs font-mono">
              <span class="flex items-center gap-1.5 text-slate-600 font-semibold">
                <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span>
                SAP_ARCHITECTURE.SYS
              </span>
              <span class="text-amber-800 font-bold bg-amber-50 px-2 py-0.5 rounded border border-amber-200/60">CLEAN CORE CERTIFIED</span>
            </div>

            {/* Architecture SVG Flow */}
            <svg class="w-full h-64 text-slate-700" viewBox="0 0 360 220" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Top Layer: UI & Extensions */}
              <rect x="15" y="15" width="100" height="36" rx="6" class="fill-slate-50 stroke-slate-300" stroke-width="1.2" />
              <text x="27" y="37" class="fill-slate-800 text-[10px] font-bold font-mono">SAP FIORI / UI5</text>

              <rect x="130" y="15" width="100" height="36" rx="6" class="fill-slate-50 stroke-slate-300" stroke-width="1.2" />
              <text x="139" y="37" class="fill-slate-800 text-[10px] font-bold font-mono">CUSTOM APPS</text>

              <rect x="245" y="15" width="100" height="36" rx="6" class="fill-slate-50 stroke-slate-300" stroke-width="1.2" />
              <text x="254" y="37" class="fill-slate-800 text-[10px] font-bold font-mono">MOBILE CLIENTS</text>

              {/* Connecting Lines Downward */}
              <line x1="65" y1="51" x2="65" y2="80" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="3 3" />
              <line x1="180" y1="51" x2="180" y2="80" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="3 3" />
              <line x1="295" y1="51" x2="295" y2="80" stroke="#CBD5E1" stroke-width="1.5" stroke-dasharray="3 3" />

              {/* Middle Layer: SAP BTP & Integration Fabric */}
              <rect x="15" y="80" width="330" height="50" rx="8" class="fill-amber-50/70 stroke-amber-300" stroke-width="1.5" />
              <text x="28" y="103" class="fill-amber-900 text-[11px] font-extrabold font-mono">SAP BTP &amp; INTEGRATION SUITE (CPI)</text>
              <text x="28" y="119" class="fill-amber-700 text-[9px] font-mono">OData V4 • Event Mesh • Cloud Connector • API Mgmt</text>
              <circle cx="325" cy="105" r="4" class="fill-amber-500 animate-ping" />

              {/* Connecting Lines to ERP Core */}
              <line x1="100" y1="130" x2="100" y2="160" stroke="#CBD5E1" stroke-width="1.5" />
              <line x1="260" y1="130" x2="260" y2="160" stroke="#CBD5E1" stroke-width="1.5" />

              {/* Bottom Layer: Digital Core */}
              <rect x="15" y="160" width="160" height="46" rx="8" class="fill-teal-50/80 stroke-teal-300" stroke-width="1.5" />
              <text x="27" y="182" class="fill-teal-950 text-[10px] font-extrabold font-mono">SAP S/4HANA CORE</text>
              <text x="27" y="196" class="fill-teal-700 text-[8px] font-mono">Clean Core • Financials • SCM</text>

              <rect x="185" y="160" width="160" height="46" rx="8" class="fill-blue-50/80 stroke-blue-300" stroke-width="1.5" />
              <text x="197" y="182" class="fill-blue-950 text-[10px] font-extrabold font-mono">SAP ANALYTICS CLOUD</text>
              <text x="197" y="196" class="fill-blue-700 text-[8px] font-mono">HANA Cloud • Real-Time SAC</text>
            </svg>

            {/* Telemetry bar */}
            <div class="mt-4 pt-3 border-t border-slate-100 grid grid-cols-3 gap-2 text-center text-[10px] font-mono">
              <div class="rounded-lg bg-slate-50 p-2">
                <div class="text-slate-400">CORE MODEL</div>
                <div class="font-bold text-slate-800">Clean Core</div>
              </div>
              <div class="rounded-lg bg-slate-50 p-2">
                <div class="text-slate-400">INTEGRATION</div>
                <div class="font-bold text-slate-800">SAP BTP CPI</div>
              </div>
              <div class="rounded-lg bg-slate-50 p-2">
                <div class="text-slate-400">UPTIME SLA</div>
                <div class="font-bold text-emerald-600">99.99%</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Pillars Deep Dive */}
  <section class="py-20 sm:py-28 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-16">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl font-display">
          Full-Lifecycle SAP Capabilities &amp; Clean Architecture
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          From legacy ECC modernization to high-speed cloud integrations, our senior SAP architects deliver precision implementations designed for effortless upgrades.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          sapPillars.map((pillar) => (
            <div class="group relative flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-7 sm:p-8 shadow-xs hover:shadow-xl hover:border-amber-400 transition-all duration-300">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-50 text-amber-800 border border-amber-200">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    {pillar.metricLabel}: <strong class="text-amber-950">{pillar.metric}</strong>
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-bold text-slate-950 font-display mb-3 group-hover:text-amber-700 transition-colors">
                  {pillar.title}
                </h3>

                <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6">
                  {pillar.description}
                </p>

                <div class="flex flex-wrap gap-1.5 mb-6">
                  {pillar.tags.map((tag) => (
                    <span class="rounded-md bg-slate-50 border border-slate-200 px-2.5 py-1 text-xs font-mono text-slate-700">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-amber-700">
                <span>Enterprise Production Grade</span>
                <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Client Deliverables & Standards */}
  <section class="py-16 bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-display">
          What Every Wellbit SAP Engagement Delivers
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600">
          We ensure clean architecture, auditable blueprints, and transparent knowledge transfer at every milestone.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-3">01</div>
          <h4 class="font-bold text-slate-900 text-sm">Clean Core Blueprints</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">Exhaustive architectural roadmaps keeping custom extensions decoupled from the standard core.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-3">02</div>
          <h4 class="font-bold text-slate-900 text-sm">Automated Test Suites</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">End-to-end regression validation and unit test harnesses across all custom RAP and OData services.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-3">03</div>
          <h4 class="font-bold text-slate-900 text-sm">Full Source Code &amp; IP</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">100% intellectual property ownership of custom Fiori apps and BTP extensions in your Git repositories.</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-2xs">
          <div class="size-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-3">04</div>
          <h4 class="font-bold text-slate-900 text-sm">24/7 Hypercare &amp; AMS</h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">Dedicated senior SAP functional and technical support with SLA-backed response times post go-live.</p>
        </div>
      </div>
    </div>
  </section>

  {/* High-Impact CTA */}
  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-navy via-slate-900 to-navy p-8 sm:p-14 text-white shadow-2xl border border-slate-800">
        <h2 class="text-3xl sm:text-4xl font-extrabold font-display">
          Ready to Modernize Your Enterprise SAP Landscape?
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Consult directly with our veteran SAP architects. We assess your ECC/S4 landscape, recommend optimal BTP integration architectures, and chart an actionable transition plan.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <div class="relative group/glow p-0.5 rounded-full bg-gradient-to-r from-amber-400 via-teal-500 to-blue-400 animate-pulse-glow shadow-xl shadow-amber-500/25">
            <Button href="/contact" variant="primary" className="px-8 py-3.5 text-base font-bold shadow-none">
              Start SAP Consultation
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            </Button>
          </div>
          <a href="tel:+918948626497" class="text-sm font-semibold text-amber-300 hover:text-white transition-colors flex items-center gap-2">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Direct Call: +91 8948626497
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
