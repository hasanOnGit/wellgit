---
import BaseLayout from '@layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

export const pageContent = {
  pageTitle: 'Engineering Articles & Insights',
  actionLabel: 'Read article',
};
---

<BaseLayout
  title="Engineering Articles & Insights | Wellbit Technologies"
  description="Technical insights, system design teardowns, and engineering best practices by Wellbit Technologies."
>
  <section class="bg-hero-gradient">
    <div class="mx-auto max-w-[85rem] px-4 pt-28 sm:pt-40 lg:pt-48 pb-12 sm:px-6 lg:px-8">
      <div class="max-w-7xl">
        <div class="mx-auto max-w-3xl lg:mx-0">
          <h1
            class="text-3xl font-bold text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {pageContent.pageTitle}
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            Articles on modern architecture, artificial intelligence systems, event-driven pipelines, and business software engineering.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div class="grid grid-cols-1 items-stretch lg:grid-cols-3">
      {
        articles.map((item, index) => {
          const totalItems = articles.length;
          const itemsPerRow = 3;

          const isLastRow =
            Math.floor(index / itemsPerRow) ===
            Math.floor((totalItems - 1) / itemsPerRow);

          const borderClasses = isLastRow
            ? index % 3 === 0
              ? 'border-none'
              : index % 3 === 1
                ? 'lg:border-x'
                : ''
            : index % 3 === 0
              ? 'border-b'
              : index % 3 === 1
                ? 'border-b lg:border-x '
                : 'border-b';

          return (
            <a
              class={`card group ${borderClasses} flex flex-col justify-between`}
              href={`/support/articles/${item.id}`}
            >
              <div class="mb-5">
                <div class="mt-5">
                  <h2 class="mt-5 text-lg font-semibold text-slate-800 group-hover:text-teal-800 transition-colors">
                    {item.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-slate-600 leading-relaxed">{item.data.description}</p>
                </div>
              </div>
              <p class="mt-auto pt-4">
                <span class="border-b-2 border-slate-400 pb-1 text-sm font-medium text-slate-700 transition duration-300 group-hover:border-teal-600 group-hover:text-teal-800">
                  {pageContent.actionLabel}
                </span>
              </p>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
