---
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

export const pageContent = {
  pageTitle: 'Engineering Knowledge & Technical Resources',
  content:
    'Explore comprehensive documentation, architectural guides, API references, and technical teardowns from the Wellbit Technologies engineering team.',
};

const hubs = [
  {
    title: 'Engineering Articles & Insights',
    description:
      'In-depth articles covering modern full-stack development, LLM fine-tuning, retrieval pipelines, and distributed data systems.',
    link: '/support/articles',
    icon: 'articles',
  },
  {
    title: 'Architecture Whitepapers',
    description:
      'Detailed whitepapers on reliable AI agent workflows, enterprise RAG patterns, and high-concurrency event-driven processing.',
    link: '/support/whitepapers',
    icon: 'blankDocument',
  },
  {
    title: 'System Reference & Standards',
    description:
      'Technical architecture specifications, stack compatibility matrices, and engineering governance frameworks.',
    link: '/support/reference',
    icon: 'documentMagnifyingGlass',
  },
  {
    title: 'Architecture Consultations',
    description:
      'Need dedicated guidance on choosing the right tech stack or scoping a custom build? Connect directly with our engineering leads.',
    link: '/contact',
    icon: 'info',
  },
];

const seo = {
  title: 'Knowledge Base | Wellbit Technologies',
  description:
    'Browse Wellbit Technologies technical knowledge base, architecture articles, whitepapers, and software engineering documentation.',
};
---

<BaseLayout seo={seo}>
  <section class="bg-hero-gradient">
    <div class="mx-auto max-w-[85rem] px-4 pt-28 sm:pt-40 lg:pt-48 pb-12 sm:px-6 lg:px-8">
      <div class="max-w-7xl">
        <div class="mx-auto max-w-3xl lg:mx-0">
          <h1
            class="text-3xl font-bold text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {pageContent.pageTitle}
          </h1>
          <p
            class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
          >
            {pageContent.content}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        hubs.map(hub => (
          <a
            href={hub.link}
            class="group block p-8 rounded-2xl bg-white border border-slate-200 shadow-xs hover:border-teal-400 hover:shadow-md transition-all duration-300"
          >
            <div class="flex items-center gap-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600 group-hover:bg-btn-gradient group-hover:text-white transition-all duration-300 shadow-2xs">
                <Icon name={hub.icon} class="size-6" />
              </div>
              <h2 class="text-xl font-semibold text-slate-800 group-hover:text-teal-600 transition-colors duration-300">
                {hub.title}
              </h2>
            </div>
            <p class="mt-4 text-slate-600 text-sm leading-relaxed">
              {hub.description}
            </p>
            <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-teal-600">
              <span>Explore section</span>
              <Icon name="chevronRight" class="size-4 transition-transform duration-200 group-hover:translate-x-1" />
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
