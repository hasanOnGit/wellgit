---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';
import ContactForm from '@ui/forms/ContactForm.astro';
import type { WithContext, Thing } from 'schema-dts';

const emailHeading = 'Direct Email:';
const engineeringHeading = 'Engineering Hub:';
const resourcesHeading = 'Technical Resources & Knowledge:';

const contactDetails = {
  hubTitle: 'Wellbit Technologies',
  location: 'Global Engineering & Client Delivery',
  email: 'm.hasanmzp@gmail.com',
  phone: '+91 8948626497',
  hours: 'Monday – Friday: 9:00 AM – 7:00 PM IST',
};

const resourcesDetails = {
  description: 'Explore our technical whitepapers, architecture references, and engineering insights.',
  linkText: 'Explore Knowledge Base & Insights',
  linkUrl: '/support/knowledge-base',
};

// Content for the page title and subtitle
const title = "Let's Build Something Meaningful";
const subTitle =
  'Have a project in mind, an architectural challenge, or need a dedicated engineering team? Send us a message and our technical leaders will reach out promptly.';

// SEO metadata for the page
const seo = {
  title: 'Contact Wellbit Technologies | Custom Software & AI Engineering',
  description:
    'Get in touch with Wellbit Technologies to discuss custom software development, AI solutions, intelligent agents, and workflow automation systems.',
};

// Schema.org metadata for SEO
const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  inLanguage: 'en-US',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Contact Wellbit Technologies',
  description:
    'Connect with Wellbit Technologies for custom software development, artificial intelligence systems, and enterprise digital solutions.',
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Wellbit Technologies',
    description: 'Engineering Intelligence. Building Possibilities.',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  <div class="mx-auto max-w-[85rem] px-4 pt-28 sm:pt-40 lg:pt-48 pb-16 sm:pb-28 sm:px-6 lg:px-8">
    <div class="mb-8 sm:mb-10 max-w-3xl lg:mb-14">
      <h1
        class="text-3xl font-bold text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
      >
        {title}
      </h1>
      <p class="mt-3 sm:mt-4 text-base sm:text-lg text-slate-600">{subTitle}</p>
    </div>

    <div class="grid grid-cols-1 gap-x-10 md:grid-cols-2 lg:gap-x-16">
      <div
        class="mb-10 h-fit rounded-2xl bg-white border border-slate-200 p-3 sm:p-5 shadow-sm md:order-2 md:mb-0"
      >
        <ContactForm />
      </div>

      <div class="space-y-10">
        <div class="flex gap-x-5">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600 border border-slate-200 shadow-2xs">
            <Icon name="email" class="size-5 shrink-0" />
          </div>
          <div class="grow">
            <h4 class="font-semibold text-slate-700">{emailHeading}</h4>
            <div class="mt-1 flex flex-col gap-1 text-sm text-slate-600">
              <a
                class="font-medium text-slate-800 transition-colors duration-200 hover:text-teal-700 focus:text-teal-700 focus:outline-hidden"
                href={`mailto:${contactDetails.email}`}
              >
                {contactDetails.email}
              </a>
            </div>
            <p class="mt-1.5 text-xs text-slate-500">Direct engineering leadership and inquiry intake.</p>
          </div>
        </div>

        <div class="flex gap-x-5">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600 border border-slate-200 shadow-2xs">
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="grow">
            <h4 class="font-semibold text-slate-700">Phone & WhatsApp:</h4>
            <div class="mt-1 flex flex-col gap-1 text-sm text-slate-600">
              <a
                class="font-medium text-slate-800 transition-colors duration-200 hover:text-teal-700 focus:text-teal-700 focus:outline-hidden"
                href={`tel:${contactDetails.phone.replace(/\s+/g, '')}`}
              >
                {contactDetails.phone}
              </a>
            </div>
            <p class="mt-1.5 text-xs text-slate-500">Available Mon–Fri 9:00 AM – 7:00 PM IST for consultations.</p>
          </div>
        </div>

        <div class="flex gap-x-5">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600 border border-slate-200 shadow-2xs">
            <Icon name="mapPin" class="size-5 shrink-0" />
          </div>
          <div class="grow">
            <h4 class="font-semibold text-slate-700">{engineeringHeading}</h4>
            <div class="mt-1 text-sm text-slate-600">
              <p class="font-medium text-slate-700">{contactDetails.hubTitle}</p>
              <p class="text-slate-500">{contactDetails.location}</p>
              <p class="mt-1 text-xs text-slate-500">{contactDetails.hours}</p>
            </div>
          </div>
        </div>

        <div class="flex gap-x-5">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600 border border-slate-200 shadow-2xs">
            <Icon name="info" class="size-5 shrink-0" />
          </div>
          <div class="grow">
            <h4 class="font-semibold text-slate-700">{resourcesHeading}</h4>
            <p class="mt-1 text-sm text-slate-500">
              {resourcesDetails.description}
            </p>
            <p class="mt-3">
              <a
                class="group inline-flex items-center gap-x-2 text-sm font-medium text-teal-800 decoration-2 transition duration-300 hover:underline focus:underline focus:outline-hidden"
                href={resourcesDetails.linkUrl}
              >
                {resourcesDetails.linkText}
                <Icon name="chevronRight" class="size-4" />
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Automatically adjusting the height of the textarea
    // based on its content. Triggers when the textarea content changes.
    document.addEventListener('astro:page-load', () => {
      function textareaAutoHeight(
        el: HTMLTextAreaElement,
        offsetTop: number = 0
      ): void {
        el.style.height = 'auto';
        el.style.height = `${el.scrollHeight + offsetTop}px`;
      }

      (() => {
        const textareas: string[] = ['#input-message'];

        textareas.forEach(selector => {
          const textarea = document.querySelector(
            selector
          ) as HTMLTextAreaElement;

          if (!textarea) return;

          const overlay = textarea.closest('.hs-overlay');

          if (overlay) {
            const instance = (window as any).HSOverlay?.getInstance(
              overlay,
              true
            );

            if (instance) {
              instance.element.on('open', () =>
                textareaAutoHeight(textarea, 3)
              );
            }
          } else {
            textareaAutoHeight(textarea, 3);
          }

          textarea.addEventListener('input', () => {
            textareaAutoHeight(textarea, 3);
          });
        });
      })();
    });
  </script>
</BaseLayout>
