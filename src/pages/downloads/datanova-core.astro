---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Engineering Specs & Capabilities';
const title = 'Core Engineering Architecture & Platform Specifications';
const subTitle =
  'Wellbit Technologies builds resilient backend platforms, autonomous AI agent pipelines, business workflow automation, and responsive enterprise portals engineered for high-concurrency production workloads.';

// Architecture Link
const compareLinkTitle = 'Explore platform architecture & tech stack';
const compareLink = '/platform';
const compareLinkAriaLabel =
  'Explore Wellbit Technologies architecture deep dive and system integration stack.';

// Capabilities
const coreBackend = {
  title: 'Distributed Systems & Cloud Services',
  description:
    'Resilient microservices and event-driven architectures built with Go, Python, and TypeScript. Featuring high-throughput streaming with Apache Kafka, relational durability via PostgreSQL, and ultra-low latency caching with Redis.',
  cta: {
    text: 'View Architecture Details',
    link: '/platform',
  },
};

const aiSystems = {
  title: 'AI Agents & Intelligent Automation',
  description:
    'Autonomous agent networks, enterprise Retrieval-Augmented Generation (RAG) pipelines, and intelligent workflow automation designed with strict data isolation, guardrails, and deterministic evaluation benchmarks.',
  cta: {
    text: 'Schedule AI Consultation',
    link: '/contact',
  },
};

// Small Info Section
const smallInfoSection = {
  intro: {
    text: 'Every Wellbit deployment includes comprehensive architecture documentation, OpenAPI specs, and complete private repository ownership.',
  },
  links: [
    {
      text: 'Read technical whitepapers & architecture blueprints',
      href: '/support/whitepapers',
      ariaLabel: 'Read technical whitepapers and architecture blueprints',
    },
    {
      text: 'Browse engineering articles & system designs',
      href: '/support/articles',
      ariaLabel: 'Browse engineering articles and system designs',
    },
  ],
};

// Technology Grid Section
const largeInfoSection = {
  stackOverview: {
    title: 'Technology Ecosystem',
    content: 'We engineer with battle-tested, high-performance technologies:',
    technologies: [
      { name: 'TypeScript & Node.js / Bun', category: 'Runtime' },
      { name: 'Python & FastAPI / PyTorch', category: 'AI & Data' },
      { name: 'Go (Golang)', category: 'High-Concurrency Services' },
      { name: 'React, Next.js & Astro', category: 'Frontend' },
      { name: 'PostgreSQL, ClickHouse & Redis', category: 'Datastores' },
      { name: 'Apache Kafka & RabbitMQ', category: 'Event Streaming' },
      { name: 'Docker & Kubernetes (K8s)', category: 'Containerization' },
      { name: 'AWS, GCP & Terraform', category: 'Cloud Infrastructure' },
    ],
  },
  securityReliability: {
    title: 'Security & Reliability Standards',
    content:
      'OWASP-compliant application hardening, role-based access control (RBAC), end-to-end encryption in transit and at rest, and automated dependency vulnerability scans integrated into every CI/CD workflow.',
  },
  observability: {
    title: 'Production Observability & SLA Monitoring',
    content:
      'Full-stack telemetry via OpenTelemetry, Prometheus metrics, structured JSON logging, and Grafana dashboards for proactive incident detection, alerting, and high system availability.',
  },
};
---

<BaseLayout
  title="Engineering Architecture & Capabilities | Wellbit Technologies"
  description="Explore the technical capabilities, architecture patterns, and engineering standards behind Wellbit Technologies custom software and AI platforms."
>
  <section class="mx-auto max-w-[85rem] px-4 pt-28 sm:pt-40 lg:pt-48 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">{preTitle}</p>
        <h1
          class="mt-1 text-3xl font-bold text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {title}
        </h1>
        <p
          class="mt-8 max-w-xl text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {subTitle}
        </p>
        <a
          class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-teal-800 shadow-lg shadow-transparent transition duration-300 hover:text-teal-950 focus:outline-hidden"
          href={compareLink}
          aria-label={compareLinkAriaLabel}
        >
          {compareLinkTitle}
          <Icon name="chevronRight" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="mx-auto mt-16 grid max-w-lg grid-cols-1 items-center gap-y-6 px-4 sm:mt-20 md:px-0 lg:max-w-4xl lg:grid-cols-2 lg:gap-y-0"
  >
    <div
      class="rounded-3xl rounded-t-3xl bg-white/60 p-8 ring-1 ring-slate-900/10 sm:p-10 lg:rounded-tr-none lg:rounded-b-none lg:rounded-bl-3xl"
    >
      <h3 class="text-2xl font-semibold text-slate-700">
        {coreBackend.title}
      </h3>

      <p class="mt-6 text-base/6 text-slate-600 sm:mt-8">
        {coreBackend.description}
      </p>
      <a
        href={coreBackend.cta.link}
        aria-describedby={coreBackend.title}
        class="mt-8 block rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold ring-1 ring-teal-700 transition duration-300 ring-inset hover:bg-teal-700/80 hover:text-white focus:bg-teal-700 focus:text-white focus:outline-hidden sm:mt-10"
      >
        {coreBackend.cta.text}
      </a>
    </div>

    <div
      class="relative flex flex-col justify-evenly rounded-3xl bg-teal-700 p-8 shadow-2xl ring-1 ring-teal-900/10 sm:p-10 lg:h-[120%]"
    >
      <h3 class="text-2xl font-semibold text-teal-100">
        {aiSystems.title}
      </h3>

      <p class="mt-6 text-base/6 text-teal-50 sm:mt-8">
        {aiSystems.description}
      </p>

      <a
        href={aiSystems.cta.link}
        aria-describedby={aiSystems.title}
        class="mt-8 block rounded-lg bg-teal-600 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs transition-colors duration-300 hover:bg-teal-500 focus:bg-teal-500 focus:outline-hidden sm:mt-10"
      >
        {aiSystems.cta.text}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pt-32 pb-16 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid grid-rows-1 content-center divide-y divide-dashed divide-slate-300 lg:mx-0 lg:grid-cols-2 lg:divide-x lg:divide-y-0"
    >
      <div class="py-5 sm:p-5">
        <p
          class="inline-flex gap-x-4 font-medium text-pretty text-slate-700 sm:text-lg/8"
        >
          <Icon name="info" class="size-8 text-teal-700 shrink-0" />
          {smallInfoSection.intro.text}
        </p>
      </div>
      <div class="flex flex-col justify-evenly p-5">
        {
          smallInfoSection.links.map((link, index) => (
            <a
              class={`${index === 1 ? 'mt-5' : ''} group inline-flex w-fit items-center gap-x-2 font-medium text-teal-800 transition duration-300 hover:text-teal-950 focus:outline-hidden`}
              href={link.href}
              aria-label={link.ariaLabel}
            >
              {link.text}
              <Icon name="chevronRight" class="size-4" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="grid rounded-3xl bg-section-gradient border border-slate-200 px-5 py-5 shadow-xs md:grid-cols-2 md:grid-rows-2"
    >
      <div class="py-5 sm:p-5 md:row-span-2 md:content-center">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {largeInfoSection.stackOverview.title}
        </h3>

        <p class="mt-4 text-base text-pretty text-slate-700">
          {largeInfoSection.stackOverview.content}
        </p>

        <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 list-inside list-none px-2 text-slate-800 text-sm">
          {
            largeInfoSection.stackOverview.technologies.map(tech => (
              <li class="flex items-center gap-2 rounded-lg bg-white border border-slate-200 px-3 py-2 shadow-2xs">
                <span class="size-2 rounded-full bg-teal-600"></span>
                <span class="font-medium">{tech.name}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="border-t border-dashed border-slate-400 py-5 sm:p-5 md:content-center md:border-t-0 md:border-l"
      >
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {largeInfoSection.securityReliability.title}
        </h3>
        <p class="mt-4 text-base text-pretty text-slate-700">
          {largeInfoSection.securityReliability.content}
        </p>
      </div>

      <div
        class="border-t border-dashed border-slate-400 py-5 sm:p-5 md:col-start-2 md:row-start-2 md:content-center md:border-l"
      >
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {largeInfoSection.observability.title}
        </h3>

        <p class="mt-4 text-base text-pretty text-slate-700">
          {largeInfoSection.observability.content}
        </p>
      </div>
    </div>
  </section>

  <style>
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url(/guilloche.svg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
