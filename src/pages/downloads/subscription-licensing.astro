---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Engagement & Retainers';
const title = 'Ongoing Engineering Without Unnecessary Complexity';
const subTitle =
  'Gain predictable access to senior software engineers, workflow specialists, and AI practitioners for <i>active product roadmaps</i>, <i>system maintenance</i>, and <i>architectural guidance</i> — with full codebase ownership.';

// Features
const features = [
  { text: 'Retainers for active product roadmaps' },
  { text: 'Maintenance agreements for stable production applications' },
  { text: 'Full intellectual property & private repository ownership' },
  { text: 'Transparent sprint planning & clear communication channels' },
];

// Subscribe Link
const subscribeLinkTitle = 'Discuss Retainer Scope';
const subscribeLink = '/contact';

// Info Section
const infoSection = {
  stackIntegration: {
    title: 'Stack & Workflow Integration',
    description:
      'Our squads seamlessly embed into your existing engineering ecosystem — Git, CI/CD pipelines, cloud providers (AWS, GCP, Azure), issue tracking, and communication channels like Slack or Microsoft Teams.',
  },
  retainerGovernance: {
    description:
      'Every retainer includes weekly milestone demos, transparent code reviews, bi-weekly architecture audits, and proactive vulnerability monitoring to ensure your production systems remain resilient and scalable.',
  },
};

// FAQ Section
const faqSection = {
  title: 'Frequently Asked Questions',
  faqs: [
    {
      question: 'How does monthly retainer allocation work?',
      answer:
        'We assign dedicated senior engineering hours or squads to your roadmap. You receive full sprint visibility with prioritized backlog grooming, bi-weekly deliverables, and continuous communication.',
    },
    {
      question: 'Who owns the intellectual property and code?',
      answer:
        'You retain 100% ownership of all source code, documentation, architecture diagrams, and intellectual property developed during our engagement. Everything is committed directly to your private repositories.',
    },
    {
      question: 'Can we scale capacity up or down?',
      answer:
        'Yes. We offer flexible capacity adjustments, allowing your organization to ramp up for key releases or scale back during maintenance cycles without bureaucratic friction.',
    },
    {
      question: 'What production support SLAs do you provide?',
      answer:
        'For production applications and critical integrations, we define explicit response tiers, scheduled maintenance windows, and rapid hotfix deployment procedures directly in your service agreement.',
    },
    {
      question: 'Can we start with an initial pilot or proof of concept?',
      answer:
        'Yes. Many enterprise partners begin with a targeted technical discovery sprint or proof of concept to validate architectural feasibility before committing to an ongoing retainer.',
    },
  ],
};
---

<BaseLayout
  title="Engineering Retainers & Support | Wellbit Technologies"
  description="Flexible monthly engineering retainers, dedicated software squads, and SLA-backed production maintenance by Wellbit Technologies."
>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">
          {preTitle}
        </p>
        <h1
          class="mt-1 text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {title}
        </h1>
        <p
          class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          <Fragment set:html={subTitle} />
        </p>

        <div
          class="mt-10 grid auto-rows-fr grid-rows-2 gap-2 sm:gap-6 md:grid-cols-2"
        >
          {
            features.map(feature => (
              <div class="flex gap-x-2">
                <Icon name="checkCircle" class="text-teal-700" />
                <div class="grow">
                  <p class="text-slate-600">{feature.text}</p>
                </div>
              </div>
            ))
          }
        </div>

        <a
          href={subscribeLink}
          class="mt-8 inline-block rounded-lg bg-teal-600 px-6 py-3 text-center font-semibold text-white shadow-xs transition-colors duration-300 hover:bg-teal-700 focus:bg-teal-700 focus:outline-hidden sm:mt-10"
        >
          {subscribeLinkTitle}
        </a>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="relative grid divide-y divide-dashed divide-slate-200 overflow-hidden rounded-3xl bg-section-gradient border border-slate-200 px-5 py-5 shadow-xs md:grid-cols-2 md:divide-x md:divide-y-0"
    >
      <div class="content-center py-5 sm:p-5">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {infoSection.stackIntegration.title}
        </h3>
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {infoSection.stackIntegration.description}
        </p>
      </div>

      <div class="svgBlock py-5 sm:p-5">
        <Icon name="info" class="size-8 text-slate-700" />
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {infoSection.retainerGovernance.description}
        </p>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div class="mx-auto mb-10 max-w-2xl lg:mb-14">
      <h2
        class="text-2xl font-semibold tracking-tight text-balance text-slate-800 md:text-3xl md:leading-tight"
      >
        {faqSection.title}
      </h2>
    </div>

    <div class="mx-auto max-w-2xl divide-y divide-slate-200">
      {
        faqSection.faqs.map(faq => (
          <div class="py-8 first:pt-0 last:pb-0">
            <div class="flex gap-x-5">
              <Icon name="questionMark" class="text-teal-700" />

              <div class="grow">
                <h3 class="font-semibold text-slate-600 md:text-lg">
                  {faq.question}
                </h3>
                <p class="mt-2 text-slate-500">
                  <Fragment set:html={faq.answer} />
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <style>
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url(/guilloche.svg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px, 20px;
      opacity: 0.075;
      background-clip: padding-box;
      mask-image: linear-gradient(270deg, rgb(0, 0, 0), rgba(0, 0, 0, 0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
