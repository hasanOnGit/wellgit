---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Engagement & Delivery';
const title = 'Flexible Engagement. Clear Delivery.';
const subTitle =
  'Choose a delivery approach that matches your scope, timeline, budget, and ongoing engineering needs.';

// Comparison Table Link
const compareLinkTitle = 'Compare engagement models in detail';
const compareLink = '/downloads/editions';
const compareLinkAriaLabel =
  'Explore the detailed model comparison between Milestone-Based Delivery and Dedicated Engineering Support.';

// Delivery Models
const milestoneTier = {
  title: 'Milestone-Based Delivery',
  price: 'Defined Scope',
  priceDescription: '/Milestone-Based',
  description: [
    'Best for projects with defined requirements and clear deliverables.',
    'Includes requirements discovery, technical planning, agreed milestones, demonstrations and reviews, testing, deployment, and structured handover documentation.',
  ],
  cta: {
    text: 'Request Project Scope',
    link: '/downloads/request-quote',
  },
};

const squadTier = {
  title: 'Dedicated Engineering Support',
  price: 'Agile Capacity',
  priceDescription: '/Monthly Agreement',
  description: [
    'Best for evolving products, continuous iterations, and ongoing development.',
    'Includes agreed engineering capacity, sprint planning, incremental delivery, regular code reviews, technical documentation, and continuous product improvement.',
  ],
  cta: {
    text: 'Discuss Engineering Support',
    link: '/contact',
  },
};

// Features
const features = [
  {
    title: 'Code & IP Ownership',
    description:
      'You retain full intellectual property, architecture documentation, and codebase ownership as agreed in your project contract.',
    className: 'rounded-xl lg:rounded-l-xl lg:rounded-r-none',
  },
  {
    title: 'Transparent Collaboration',
    description:
      'Regular progress demonstrations, sprint reviews, and direct communication ensure alignment throughout the engagement.',
    className: 'rounded-xl lg:rounded-none',
  },
  {
    title: 'Engineering Rigor',
    description:
      'Clean architecture patterns, thorough automated testing, and security best practices standard across every deliverable.',
    className: 'rounded-xl lg:rounded-r-xl lg:rounded-l-none',
  },
];

// Info Section
const infoSections = [
  {
    title: 'Engineering Governance & Transparency',
    content: [
      'Every engagement operates under structured engineering practices: documented architectural decisions, sprint reviews, thorough testing, and direct access to your engineering leads.',
      'We integrate into your preferred collaboration tools — GitHub, GitLab, Jira, Slack, AWS, and Google Cloud.',
    ],
    className: 'md:row-span-2 md:content-center py-5 sm:p-5',
    icon: null,
  },
  {
    title: null,
    content: [
      `Need guidance determining the most appropriate technical approach or engagement structure? Reach out directly to our engineering team at <a href='mailto:contact@wellbit.in' aria-label='Engineering contact email' class="font-medium text-slate-800 underline decoration-teal-600 hover:text-teal-900 transition-colors duration-300">contact@wellbit.in</a> or submit your project details online.`,
    ],
    className:
      'md:content-center md:border-l border-t md:border-t-0 border-dashed border-slate-400 py-5 sm:p-5',
    icon: 'info',
    iconClass: 'shrink-0 size-8 text-slate-700 mt-6',
  },
  {
    title: 'Security and Data Protection',
    content: [
      'Wellbit designs and delivers systems adhering to modern software security best practices, role-based access control, secure transport, and careful secret management.',
    ],
    className:
      'md:col-start-2 md:row-start-2 md:content-center md:border-l border-t border-dashed border-slate-400 py-5 sm:p-5',
    icon: null,
  },
];
---

<BaseLayout
  title="Delivery Models & Engagement | Wellbit Technologies"
  description="Flexible engagement models: milestone-based delivery and dedicated engineering support tailored to your project requirements."
>
  <section class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-xl lg:mx-0">
        <p class="text-base/7 font-medium text-slate-400">{preTitle}</p>
        <h1
          class="mt-1 text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
        >
          {title}
        </h1>
        <p
          class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8"
        >
          {subTitle}
        </p>
        <a
          href={compareLink}
          class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-teal-800 shadow-lg shadow-transparent transition duration-300 hover:text-teal-950 focus:outline-hidden"
          aria-label={compareLinkAriaLabel}
        >
          {compareLinkTitle}
          <Icon name="chevronRight" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <section
    class="mx-auto mt-16 grid max-w-lg grid-cols-1 items-center gap-y-6 px-4 sm:mt-20 md:px-0 lg:max-w-4xl lg:grid-cols-2 lg:gap-y-0"
  >
    <div
      class="rounded-3xl rounded-t-3xl bg-white/60 p-8 ring-1 ring-slate-900/10 sm:p-10 lg:rounded-tr-none lg:rounded-b-none lg:rounded-bl-3xl"
    >
      <h3 class="text-base/7 font-semibold text-slate-600">
        {milestoneTier.title}
      </h3>
      <p class="mt-4 flex items-baseline gap-x-2">
        <span class="text-3xl font-semibold tracking-tight text-slate-900"
          >{milestoneTier.price}</span
        >
        <span class="text-base text-slate-500"
          >{milestoneTier.priceDescription}</span
        >
      </p>
      {
        milestoneTier.description.map((desc, index) => (
          <p
            class={`${index === 0 ? 'mt-6 text-base font-medium text-slate-600' : 'mt-8 text-base/6 text-slate-600 sm:mt-10'} `}
          >
            {desc}
          </p>
        ))
      }
      <a
        href={milestoneTier.cta.link}
        aria-describedby={milestoneTier.title}
        class="mt-8 block rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold ring-1 ring-teal-700 transition duration-300 ring-inset hover:bg-teal-700/80 hover:text-white focus:bg-teal-700 focus:text-white focus:outline-hidden sm:mt-10"
      >
        {milestoneTier.cta.text}
      </a>
    </div>

    <div
      class="relative flex flex-col justify-evenly rounded-3xl bg-teal-700 p-8 shadow-2xl ring-1 ring-teal-900/10 sm:p-10 lg:h-[120%]"
    >
      <h3 class="text-base/7 font-semibold text-teal-100">
        {squadTier.title}
      </h3>
      <p class="mt-4 flex items-baseline gap-x-2">
        <span class="text-3xl font-semibold tracking-tight text-white"
          >{squadTier.price}</span
        >
        <span class="text-base text-teal-200"
          >{squadTier.priceDescription}</span
        >
      </p>
      {
        squadTier.description.map((desc, index) => (
          <p
            class={`${index === 0 ? 'mt-6 text-base font-medium text-teal-50 lg:mt-0' : 'mt-8 text-base/6 text-teal-50 sm:mt-10'}`}
          >
            {desc}
          </p>
        ))
      }

      <a
        href={squadTier.cta.link}
        aria-describedby={squadTier.title}
        class="mt-8 block rounded-lg bg-teal-600 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs transition-colors duration-300 hover:bg-teal-500 focus:bg-teal-500 focus:outline-hidden sm:mt-10"
      >
        {squadTier.cta.text}
      </a>
    </div>
  </section>

  <section class="py-24 sm:py-40">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <dl class="grid grid-cols-1 gap-x-3 gap-y-16 text-center lg:grid-cols-3">
        {
          features.map(({ title, description, className }) => (
            <div class={`flex flex-col gap-y-4 bg-slate-100 border border-slate-200 rounded-2xl p-10 shadow-2xs ${className}`}>
              <dt class="text-base/7 text-slate-600">{description}</dt>
              <dd class="order-first text-2xl font-medium tracking-tight text-slate-900">
                <h3>{title}</h3>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 md:pb-14 lg:px-8 lg:pb-20"
  >
    <div
      class="relative grid overflow-hidden rounded-3xl bg-section-gradient border border-slate-200 px-5 py-5 shadow-xs md:grid-cols-2 md:grid-rows-2"
    >
      {
        infoSections.map(({ title, content, className, icon, iconClass }) => (
          <div class={className}>
            {title && (
              <h3 class="text-2xl font-bold tracking-tight text-balance text-slate-800">
                {title}
              </h3>
            )}
            {icon && <Icon name={icon} class={iconClass} />}

            {content.map(paragraph => (
              <p class="mt-6 text-lg/8 text-pretty text-slate-700">
                <Fragment set:html={paragraph} />
              </p>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
