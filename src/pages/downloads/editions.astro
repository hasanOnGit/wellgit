---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';

// Hero
const preTitle = 'Engagement Models';
const title = 'Milestone Delivery & Dedicated Engineering Squads';
const description = [
  {
    content:
      'Wellbit offers flexible collaboration models tailored to your operational velocity, technical complexity, and long-term roadmap.',
  },
  {
    content:
      'Our <strong>Milestone Delivery</strong> model is built for well-defined initiatives: custom applications, AI integrations, or workflow automation platforms with clear specifications and fixed phases.',
  },
  {
    content:
      'Our <strong>Dedicated Engineering Squad</strong> model provides full-stack developers, AI engineers, and system architects who integrate seamlessly into your team for ongoing product iteration.',
  },
];

// Comparison Table
const comparisonData = [
  {
    feature: 'Architecture discovery & technical specifications',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Custom full-stack web application engineering',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Business process automation & third-party system integrations',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Autonomous AI agents & custom LLM/RAG pipelines',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Custom CRM platforms & operational dashboards',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Automated CI/CD pipelines & production deployment',
    essential: true,
    advanced: true,
  },
  {
    feature: 'Dedicated full-time senior engineering squad',
    essential: false,
    advanced: true,
  },
  {
    feature: 'Real-time daily standups & collaborative sprint management',
    essential: false,
    advanced: true,
  },
  {
    feature: 'Dynamic sprint backlog reprioritization',
    essential: false,
    advanced: true,
  },
  {
    feature: 'High-availability infrastructure monitoring & SLA support',
    essential: false,
    advanced: true,
  },
  {
    feature: 'Continuous legacy modernization & refactoring',
    essential: false,
    advanced: true,
  },
];

// Info Section
const infoSection = {
  title: 'Engineering Governance & Transparency',
  description:
    'Every Wellbit engagement includes rigorous code reviews, automated test coverage, complete IP ownership, and direct communication with senior engineers. Final terms, scope, and deliverables depend on the agreed proposal and contract.',
  trialInfo:
    'Schedule a technical discovery call to review requirements, system architecture, and delivery timelines.',
  buttons: [
    {
      text: 'Schedule Technical Discovery',
      link: '/contact',
      style: 'bg-teal-600 text-white hover:bg-teal-600/80 focus:bg-teal-600/80',
    },
    {
      text: 'Request a Detailed Proposal',
      link: '/downloads/request-quote',
      style:
        'bg-teal-50 hover:bg-teal-50/70 text-slate-800 focus:bg-teal-50/70',
    },
  ],
};
---

<BaseLayout
  title="Engagement & Collaboration Models | Wellbit Technologies"
  description="Explore Wellbit Technologies engagement models: milestone-based delivery and dedicated engineering squads tailored to enterprise velocity."
>
  <section class="bg-hero-gradient">
    <div class="mx-auto max-w-[85rem] px-4 pt-40 pb-12 sm:px-6 lg:px-8">
      <div class="max-w-7xl">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <p class="text-base/7 font-medium text-slate-400">{preTitle}</p>
          <h1
            class="mt-1 text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {title}
          </h1>
          {
            description.map(desc => (
              <p class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8">
                <Fragment set:html={desc.content} />
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div
      class="relative mx-auto max-w-[60rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
    >
      <div class="hidden py-2 md:block">
        <div class="grid grid-cols-4 gap-6">
          <div class="col-span-1 col-start-3 mx-auto">
            <h3 class="text-center text-lg font-medium text-slate-800">
              Milestone Delivery
            </h3>
          </div>
          <div class="col-span-1 mx-auto">
            <h3 class="text-center text-lg font-medium text-slate-800">
              Dedicated Squad
            </h3>
          </div>
        </div>
      </div>

      <div class="space-y-4 md:space-y-0">
        {
          comparisonData.map(item => (
            <ul class="grid md:grid-cols-4 md:gap-6">
              <li class="pb-1.5 md:col-span-2 md:py-3">
                <span class="flex items-center font-medium text-slate-700 md:font-normal">
                  {item.feature}
                </span>
              </li>

              <li class={`col-span-1 border-b border-slate-200 py-1.5 md:py-3`}>
                <div class="grid grid-cols-2 sm:grid-cols-4 md:flex">
                  <span class="self-end text-slate-500 sm:col-span-2 md:hidden">
                    Milestone Delivery
                  </span>
                  <span class="place-self-center md:mx-auto">
                    {item.essential ? (
                      <Icon
                        name="check"
                        class="size-5 shrink-0 text-teal-700"
                      />
                    ) : (
                      <Icon
                        name="minus"
                        class="size-5 shrink-0 text-slate-400"
                      />
                    )}
                  </span>
                </div>
              </li>

              <li class={`col-span-1 border-b border-slate-200 py-1.5 md:py-3`}>
                <div class="grid grid-cols-2 sm:grid-cols-4 md:flex">
                  <span class="self-end text-slate-500 sm:col-span-2 md:hidden">
                    Dedicated Squad
                  </span>
                  <span class="place-self-center md:mx-auto">
                    {item.advanced ? (
                      <Icon
                        name="check"
                        class="size-5 shrink-0 text-teal-700"
                      />
                    ) : (
                      <Icon
                        name="minus"
                        class="size-5 shrink-0 text-slate-400"
                      />
                    )}
                  </span>
                </div>
              </li>
            </ul>
          ))
        }
      </div>
    </div>
  </section>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="grid divide-y divide-dashed divide-slate-200 rounded-3xl bg-section-gradient border border-slate-200 px-5 py-5 shadow-xs lg:grid-cols-2 lg:divide-x lg:divide-y-0"
    >
      <div class="content-center py-5 sm:p-5">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {infoSection.title}
        </h3>

        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {infoSection.description}
        </p>
      </div>

      <div class="py-5 sm:p-5">
        <Icon name="info" class="size-8" />

        <p class="mt-6 mb-8 text-lg/8 text-pretty text-slate-700 sm:mb-10">
          {infoSection.trialInfo}
        </p>

        <div class="mx-auto flex flex-col gap-4 sm:flex-row sm:justify-center">
          {
            infoSection.buttons.map(button => (
              <a
                href={button.link}
                class={`mx-auto flex w-full items-center justify-center rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold transition duration-300 focus:outline-hidden sm:w-1/2 ${button.style}`}
              >
                {button.text}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
