---
import Navbar from '@sections/Navbar.astro';
import Footer from '@sections/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SEO, type Props as SEOProps } from 'astro-seo';
import type { WithContext, Thing } from 'schema-dts';
import { AstroFont } from 'astro-font';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  seo?: SEOProps; // Optional SEO properties to customize meta tags
  schema?: WithContext<Thing> | Record<string, unknown>; // Optional schema.org properties for structured data
  noindex?: boolean; // Set true for 404 or non-indexable pages
}

const { title, description, schema, noindex = false } = Astro.props;
const seo = Astro.props.seo ?? (title || description ? { title, description } : undefined);

// Ensure canonical URL is always normalized to production origin https://wellbit.in
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalURL = rawPath === '/' ? 'https://wellbit.in/' : `https://wellbit.in${rawPath}`;
const siteURL = 'https://wellbit.in';
const socialImage = `${siteURL}/social.png`;

const pageTitle =
  seo?.title ??
  title ??
  'Wellbit Technologies — Engineering Intelligence. Building Possibilities.';
const pageDescription =
  seo?.description ??
  description ??
  'Wellbit builds custom software, AI-powered solutions, and scalable digital platforms that help businesses automate operations, solve complex challenges, and accelerate growth.';

// Root Knowledge Graph Organization Schema
const organizationEntity = {
  '@type': 'Organization',
  '@id': `${siteURL}/#organization`,
  name: 'Wellbit Technologies',
  legalName: 'Wellbit Technologies',
  alternateName: ['Wellbit', 'Wellbit Tech', 'wellbit.in'],
  url: siteURL,
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteURL}/#logo`,
    url: `${siteURL}/icon-512.png`,
    caption: 'Wellbit Technologies Logo',
    inLanguage: 'en-US',
    width: '512',
    height: '512',
  },
  image: socialImage,
  description:
    'Wellbit Technologies is an enterprise technology solutions partner specializing in custom software engineering, AI solutions, intelligent agents, workflow automation, and digital transformation.',
  slogan: 'Engineering Intelligence. Building Possibilities.',
  email: 'contact@wellbit.in',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'contact@wellbit.in',
      availableLanguage: ['English', 'Hindi'],
    },
  ],
  knowsAbout: [
    'Custom Software Engineering',
    'Enterprise AI Solutions',
    'Autonomous AI Agents',
    'Workflow Automation',
    'Modern Web Applications',
    'Cloud Architecture',
    'System Modernization',
    'API Integration',
  ],
  areaServed: 'Worldwide',
};

// Root WebSite Entity
const websiteEntity = {
  '@type': 'WebSite',
  '@id': `${siteURL}/#website`,
  url: siteURL,
  name: 'Wellbit Technologies',
  alternateName: ['Wellbit', 'wellbit.in'],
  description:
    'Engineering Intelligence. Building Possibilities. Custom software, AI systems, and cloud architecture.',
  publisher: {
    '@id': `${siteURL}/#organization`,
  },
  inLanguage: 'en-US',
};

// Page Entity (WebPage, AboutPage, ContactPage, CollectionPage, Article, etc.)
const pageEntity =
  schema && typeof schema === 'object'
    ? Object.assign({}, schema, {
        '@id': `${canonicalURL}#webpage`,
        url: canonicalURL,
        isPartOf: { '@id': `${siteURL}/#website` },
        publisher: { '@id': `${siteURL}/#organization` },
      })
    : {
        '@type': 'WebPage',
        '@id': `${canonicalURL}#webpage`,
        url: canonicalURL,
        name: pageTitle,
        description: pageDescription,
        inLanguage: 'en-US',
        isPartOf: { '@id': `${siteURL}/#website` },
        publisher: { '@id': `${siteURL}/#organization` },
      };

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [organizationEntity, websiteEntity, pageEntity],
};
---

<html lang="en" class="scroll-pt-32">
  <head>
    {/* SEO Meta Tags */}
    <SEO
      charset="utf-8"
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: pageTitle,
          type: 'website',
          image: socialImage,
          url: canonicalURL,
        },
        optional: {
          description: pageDescription,
          siteName: 'Wellbit Technologies',
          locale: 'en_US',
        },
        image: {
          url: socialImage,
          width: 1200,
          height: 630,
          alt: 'Wellbit Technologies — Engineering Intelligence. Building Possibilities.',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: pageTitle,
        description: pageDescription,
        image: socialImage,
        imageAlt: 'Wellbit Technologies — Engineering Intelligence. Building Possibilities.',
      }}
      extend={{
        link: [
          { rel: 'icon', href: '/favicon.ico' },
          { rel: 'icon', href: '/icon.svg', type: 'image/svg+xml' },
          { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
          { rel: 'manifest', href: '/manifest.webmanifest' },
        ],
        meta: [
          { name: 'viewport', content: 'width=device-width, initial-scale=1' },
          { name: 'generator', content: `${Astro.generator}` },
          {
            name: 'keywords',
            content:
              'Wellbit, Wellbit Technologies, wellbit.in, Wellbit Tech, enterprise software development, custom AI solutions, intelligent agent pipelines, workflow automation, digital transformation, cloud architecture',
          },
          { name: 'author', content: 'Wellbit Technologies' },
          { name: 'application-name', content: 'Wellbit Technologies' },
          { name: 'apple-mobile-web-app-title', content: 'Wellbit' },
          { name: 'theme-color', content: '#1768E8' },
          {
            name: 'robots',
            content: noindex
              ? 'noindex, nofollow'
              : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
          },
        ],
      }}
    />

    {/* Schema.org Entity Graph JSON-LD */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdGraph)} />

    {/* Client-Side Router for page transitions */}
    <ClientRouter />

    {/* Font Definitions */}
    <AstroFont
      config={[
        {
          src: [],
          name: 'DM Sans',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,100..1000&display=swap',
          preload: true,
          display: 'swap',
          selector: 'h1, h2, h3, h4',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Work Sans',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Work+Sans:wght@100..900&display=swap',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
        },
      ]}
    />

    {/* Remove duplicate font links during transitions */}
    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
      document.addEventListener('astro:before-swap', e =>
        [
          ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
            'link[as="font"]'
          ),
        ].forEach(link => link.remove())
      );
    </script>
  </head>
  <body class="bg-white selection:bg-teal-200 selection:text-slate-800">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
